class PantheonApiError(Exception):
    """A Pantheon API call failed after its one retry, or returned an undecodable body."""


class PantheonApiShapeError(PantheonApiError):
    """A Pantheon API response decoded as JSON but did not have the documented shape.

    A subclass of PantheonApiError on purpose: the sweep already treats an API failure for one
    site or environment as G5/G6 (report, count one indeterminate, carry on), and an
    unexpected shape deserves exactly that treatment rather than a traceback at exit 1
    (SPEC G17).
    """


class SessionExpiredError(Exception):
    """Re-authentication failed, or the retried request 401'd again (SPEC G7a).

    Deliberately NOT a subclass of PantheonApiError: the sweep catches PantheonApiError per
    site and per environment, so if this were one, a revoked machine token 5 minutes into a
    38-minute sweep would degrade into one indeterminate per remaining site -- ~400 SKIPPED:
    lines, exit 1, and 33 more minutes of pointless work -- instead of stopping. It must
    propagate to main() and abort with exit 2.
    """


class MachineTokenError(Exception):
    """No Pantheon machine token could be resolved without guessing (SPEC section 3)."""


def machine_token():
    """$PANTHEON_MACHINE_TOKEN, else the single JSON file in ~/.terminus/cache/tokens/.

    Zero files, several files, an unreadable file or a missing `token` key is an error, never a
    guess: picking one of several would silently sweep the wrong Pantheon account (PD#1).
    """
    from_env = os.environ.get("PANTHEON_MACHINE_TOKEN")   # inlined: a module constant named
    if from_env:                                          # *_TOKEN holding a literal trips S105
        return from_env
    cache = Path.home() / ".terminus" / "cache" / "tokens"
    if not cache.is_dir():
        raise MachineTokenError(
            f"no machine token: {cache} does not exist and $PANTHEON_MACHINE_TOKEN is unset. "
            "Authenticate terminus, or set the environment variable.")
    try:
        # Fix round 1, C1.  This scan sat outside any try/except: an unreadable cache directory
        # (e.g. left root-owned by a `sudo terminus auth:login`) raised an uncaught
        # PermissionError -- an ordinary OSError -- which escaped main() entirely (SPEC G2 says
        # "unreadable ... is an error", never an uncaught traceback at exit 1).
        files = sorted(p for p in cache.iterdir() if p.is_file())
    except OSError as e:
        raise MachineTokenError(f"could not list {cache}: {e}") from e
    if len(files) != 1:
        raise MachineTokenError(
            f"no machine token: expected exactly one file in {cache}, found {len(files)}"
            f" ({', '.join(p.name for p in files) or 'none'}). "
            "Set $PANTHEON_MACHINE_TOKEN to choose one.")
    try:
        data = json.loads(files[0].read_text())
    except (OSError, json.JSONDecodeError) as e:
        raise MachineTokenError(f"could not read {files[0]}: {e}") from e
    # A truncated Terminus cache write can leave valid JSON that is not an object at all
    # (null/123/true/a bare string) -- guard the container check itself, or "token" not in
    # data raises a bare, unnamed TypeError instead of the named MachineTokenError SPEC G2
    # requires (fix round 1, M1).
    if not isinstance(data, dict) or "token" not in data:
        raise MachineTokenError(f"{files[0]} has no 'token' key")
    return data["token"]


class ApiSession:
    """One authenticated Pantheon API session over one reused httpx connection.

    Retry policy (SPEC section 7.1): ONE retry, RETRY_SLEEP apart, on a transport failure, 5xx,
    or 429.  ONE re-authentication on a 401, which does NOT consume the transport retry -- a
    session that expires 15 minutes into a 38-minute sweep must not also spend the retry budget.
    """

    def __init__(self, client, token_value, notify=None):
        self._client = client
        self._machine_token = token_value
        # notify(message) is called when the session is re-authenticated mid-sweep (G7).  main()
        # passes a function that prints under -v; without it a session expiry is invisible at
        # every verbosity, which SPEC section 8 explicitly promises it is not.
        self._notify = notify or (lambda _message: None)
        self.token = self._authenticate()

    def _authenticate(self):
        # Fix round 1, M2: httpx.InvalidURL and httpx.StreamError are NOT httpx.HTTPError
        # subclasses (verified, httpx 0.28.1), so they would bypass this except clause.
        # API_BASE is a fixed literal here, so InvalidURL cannot arise from this call; nothing
        # in THIS file enforces that invariant, it is recorded so it is not silently assumed.
        try:
            response = self._client.post(
                f"{API_BASE}/authorize/machine-token",
                json={"machine_token": self._machine_token, "client": USER_AGENT})
        except httpx.HTTPError as e:
            raise PantheonApiError(f"could not authenticate to Pantheon: {e}") from e
        if response.status_code != 200:  # noqa: PLR2004 -- HTTP status literal
            raise PantheonApiError(
                f"could not authenticate to Pantheon: HTTP {response.status_code}")
        try:
            return response.json()["session"]
        except (json.JSONDecodeError, KeyError, TypeError) as e:
            raise PantheonApiError(f"authentication response had no session token: {e}") from e

    def _renew(self, path, *, reauthed):
        """Re-authenticate after a 401, or raise SessionExpiredError (SPEC G7a).

        Split out of get() to keep that method under ruff's C901 complexity limit -- and it
        reads better anyway: get() dispatches on status, this owns the session lifecycle.
        """
        if reauthed:
            # A second 401 on a session we just minted means the machine token itself is
            # revoked or expired.  Retrying forever, or counting it as one site's
            # indeterminate, both waste the rest of a 38-minute sweep.
            raise SessionExpiredError(
                f"{path}: HTTP 401 again after re-authenticating -- the machine token is "
                "expired or revoked")
        try:
            self.token = self._authenticate()
        except PantheonApiError as e:
            raise SessionExpiredError(f"could not re-authenticate mid-sweep: {e}") from e
        self._notify("session expired; re-authenticated")

    def get(self, path):
        """GET {API_BASE}{path} and return the decoded JSON, or raise PantheonApiError."""
        transport_attempts = 0
        reauthed = False
        # `path` is the one caller-supplied segment reaching this f-string.  SPEC section 3
        # requires the SITE argv to be quote(name, safe="")-encoded before it gets here, and
        # org_id (read straight from TOML, quoted in org_sites() per fix round 1, m3) is now
        # quoted too -- but a caller could still hand this method something that produces an
        # invalid URL by construction.  httpx.InvalidURL is NOT an httpx.HTTPError subclass
        # (verified, httpx 0.28.1), so it bypassed this handler entirely until the except clause
        # below folded it in (carry-forward from the task 5 dispatch, item 7): a hostile or
        # malformed value -- e.g. a literal newline, valid inside a TOML basic string -- reached
        # this call as an unnamed exit-1 traceback (SPEC section 7's exit 1 is reserved for
        # "completed with indeterminates", never for an uncaught exception).  httpx.StreamError
        # is deliberately NOT included here (fix round 1, m2): it is raised by response-streaming
        # misuse, which this synchronous self._client.get(...) call never performs, so it would
        # be an untested, unreachable-by-construction except arm -- exactly the kind of
        # instrument that reads as load-bearing to a future maintainer but cannot go red.
        while True:
            try:
                response = self._client.get(
                    f"{API_BASE}{path}",
                    headers={"Authorization": f"Bearer {self.token}",
                             "User-Agent": USER_AGENT})
            except (httpx.HTTPError, httpx.InvalidURL) as e:
                transport_attempts += 1
                if transport_attempts > 1:
                    raise PantheonApiError(f"{path}: {e}") from e
                time.sleep(RETRY_SLEEP)
                continue
            if response.status_code == 401:  # noqa: PLR2004 -- HTTP status literal
                self._renew(path, reauthed=reauthed)
                reauthed = True
                continue
            if response.status_code == 429 or response.status_code >= 500:  # noqa: PLR2004 -- HTTP status literals
                transport_attempts += 1
                if transport_attempts > 1:
                    raise PantheonApiError(f"{path}: HTTP {response.status_code}")
                time.sleep(RETRY_SLEEP)
                continue
            if response.status_code != 200:  # noqa: PLR2004 -- HTTP status literal
                raise PantheonApiError(f"{path}: HTTP {response.status_code}")
            try:
                return response.json()
            except json.JSONDecodeError as e:
                raise PantheonApiError(f"{path}: undecodable response body: {e}") from e


PAGE_LIMIT = 100          # the API's documented maximum
MAX_PAGES = 100           # runaway guard: 10,000 sites is far beyond any real organization
CURSOR_ATTEMPTS = 3       # requests carrying one ignored cursor tolerated before giving up
                          # (3 attempts = 2 retries) -- SPEC section 4.1's "up to 3 attempts"


class SiteListingError(Exception):
    """The organization's site list could not be enumerated completely (SPEC G4a/G4b)."""


def _require(payload, key, where):
    """payload[key], or a named PantheonApiShapeError naming what was missing (SPEC G17).

    Without this, an unexpected response shape is a bare KeyError -- an uncaught traceback whose
    exit code is 1, which SPEC section 7 reserves for "completed with indeterminates".
    """
    if not isinstance(payload, dict) or key not in payload:
        raise PantheonApiShapeError(f"{where}: response has no '{key}'")
    return payload[key]


def _require_str(payload, key, where):
    """_require(payload, key, where), additionally demanding the value be a str (SPEC G17: "a
    missing/wrongly-typed key").

    A wrongly-typed id/name that skipped this check would still reach a dict key or an f-string
    downstream -- e.g. `collected[site["id"]]` raises the bare, unnamed `TypeError: unhashable
    type: 'list'` for a list-valued id -- an uncaught exit-1 traceback in a program where exit 1
    is reserved for "completed with indeterminates" (SPEC section 7).
    """
    value = _require(payload, key, where)
    if not isinstance(value, str):
        raise PantheonApiShapeError(
            f"{where}: '{key}' should be a string, got {type(value).__name__}")
    return value


def org_sites(get, org_id):
    """Every site in the organization, as [{"id", "name"}], in the API's ascending-id order.

    The cursor has a SILENT failure mode, characterized in full in this directory's
    pantheon-api-pagination-bug-report.txt (SPEC section 4.1): `start` is honored ONLY when the
    id is the last element of a page the API has already computed.  Any other id returns the
    FIRST page again, with HTTP 200 and no error.  Three rules follow, all load-bearing:

      * Pass the last id of the page just received, and nothing else.  That is always a
        boundary, which is why this pattern works where arbitrary cursors do not.
      * Stop on a SHORT page, never on an empty one.  An empty page is legitimate (an
        organization holding an exact multiple of PAGE_LIMIT sites ends on one, verified live),
        but an UNRECOGNIZED cursor returns a full first page rather than [], so "loop until
        empty" never terminates once the loop leaves the boundaries.
      * A non-empty page that contributes zero new ids means the cursor was ignored.  Retry the
        SAME cursor; if it keeps happening, raise -- a short list here is a silent truncation of
        the whole sweep, which the CSV cannot reveal.

    Fix round 1, m3: org_id is quote(..., safe="")-encoded before it reaches the URL.  Without
    it, an org_id containing '#'/'?' (a config typo, not necessarily hostile) silently requests
    a DIFFERENT resource (`/organizations/abc` for `org_id = "abc#frag"`) rather than failing --
    loud in practice today (a 404 -> exit 2), but silent-wrong-resource is the failure class
    SPEC section 3 already requires quoting against for the SITE argv; org_id gets the same
    treatment for the same reason.
    """
    collected = {}
    cursor = None
    ignored = 0
    for _page in range(MAX_PAGES):
        path = f"/organizations/{quote(org_id, safe='')}/memberships/sites?limit={PAGE_LIMIT}"
        if cursor is not None:
            path += f"&start={cursor}"
        page = get(path)
        if not isinstance(page, list):
            raise PantheonApiShapeError(f"{path}: expected a JSON array of memberships")
        for entry in page:
            site = _require(entry, "site", path)
            _require_str(site, "id", path)
            _require_str(site, "name", path)  # read later by the sweep; a bare KeyError there
                                              # escapes main() entirely and exits 1
        fresh = [entry for entry in page if entry["site"]["id"] not in collected]
        if page and not fresh:
            ignored += 1
            if ignored >= CURSOR_ATTEMPTS:
                raise SiteListingError(
                    f"the site-list cursor {cursor} was ignored {ignored} times "
                    f"(the API kept returning the first page); only {len(collected)} sites "
                    "were listed, so the sweep would be silently incomplete. "
                    f"Run 'terminus org:site:list {org_id} --format=json | jq length' to check "
                    f"whether {len(collected)} is the true site count (SPEC section 4.1)")
            retrying(
                f"site listing cursor {cursor} was ignored (page repeated); retrying "
                f"({ignored}/{CURSOR_ATTEMPTS - 1})")
            time.sleep(RETRY_SLEEP)
            continue
        ignored = 0
        for entry in fresh:
            site = entry["site"]
            collected[site["id"]] = {"id": site["id"], "name": site["name"]}
        if len(page) < PAGE_LIMIT:
            return list(collected.values())
        cursor = page[-1]["site"]["id"]
    raise SiteListingError(
        f"the site list did not end after {MAX_PAGES} pages ({len(collected)} sites so far)")


def named_sites(get, names):
    """Resolve explicit SITE arguments to [{"id", "name"}] without paging the organization.

    quote(..., safe="") is not decoration: an argument containing '#' truncates the path and an
    argument containing '?' starts a query string, so an unencoded name would silently request a
    DIFFERENT resource instead of failing.  The name in the returned dict comes from the API
    response, not from argv, so a differently-cased argument cannot produce CSV rows whose
    site_name the downstream script fails to match (SPEC section 3).
    """
    resolved = []
    for name in names:
        where = f"/site-names/{name}"
        answer = get(f"/site-names/{quote(name, safe='')}")
        # BOTH keys go through _require_str.  An `answer.get("name", name)` fallback would
        # silently reinstate the argv spelling -- the exact mismatch SPEC section 3 requires be
        # avoided.  _require_str, not _require (whole-branch review m6, the same class as C1):
        # presence alone lets a non-str `name` reach the `shlex.join(...)` resume_command() builds
        # the section 7.3 resume line with, as the bare, unnamed `TypeError: expected string or
        # bytes-like object, got 'list'` -- an exit-1 traceback raised while REPORTING an abort,
        # which destroys the resume line SPEC section 7.3 calls the whole recovery story.  (The
        # citation named a `" ".join(...)` until the residual review: that call was replaced by
        # shlex.join in the m2 fix, but the hazard is unchanged, so the guard stays and only the
        # spelling moved.)  org_sites() and partition_domains() already type-check here.
        resolved.append({"id": _require_str(answer, "id", where),
                         "name": _require_str(answer, "name", where)})
    return resolved


def site_environments(get, site_id):
    """Every environment of a site, keyed by environment id -- multidevs included."""
    path = f"/sites/{site_id}/environments"
    environments = get(path)
    if not isinstance(environments, dict):
        # sorted() over a list would silently iterate strings, and the domains calls built from
        # them would 404 one by one -- a whole site quietly mis-swept (SPEC G17).
        raise PantheonApiShapeError(f"{path}: expected a JSON object keyed by environment id")
    return environments


def partition_domains(entries):
    """Split one environment's domain list into (custom domains, platform domains, unknown).

    Primary domains are custom domains and are IN scope.  The platform set is returned because
    the cross-site check (SPEC G13) compares each hit against it -- at zero extra API cost.
    """
    if not isinstance(entries, list):
        raise PantheonApiShapeError("domains: expected a JSON array")
    custom, platform, unknown = [], set(), []
    for entry in entries:
        if not isinstance(entry, dict):
            # A JSON array of strings would otherwise reach entry.get() and raise a bare
            # AttributeError, which escapes as an exit-1 traceback.
            raise PantheonApiShapeError(f"domains: expected objects, got {type(entry).__name__}")
        name = normalize(_require_str(entry, "id", "domains"))
        kind = entry.get("type")
        if kind == "custom":
            custom.append(name)
        elif kind == "platform":
            platform.add(name)
        else:
            # G6a.  `type` is custom|platform in every entry observed, but that is an
            # observation and not a documented enumeration -- so an unrecognized value is
            # reported and counted, never silently dropped (SPEC section 1: the expensive
            # failure is a missing row that the CSV cannot reveal).
            unknown.append((name, kind))
    return custom, platform, unknown


@dataclasses.dataclass
class Counters:
    """What the summary line reports, and what the exit code is derived from."""
    sites: int = 0
    envs: int = 0
    custom_domains: int = 0
    rows: int = 0
    indeterminate: int = 0

    def summary(self):
        return (f"sites={self.sites} envs={self.envs} custom_domains={self.custom_domains} "
                f"rows={self.rows} indeterminate={self.indeterminate}")


def platform_domain_is_dead(name):
    """True only when `name` DEFINITIVELY resolves to no address (SPEC G12).

    A transient or malformed outcome counts as alive: this check exists to warn that the
    downstream rewriter will find no addresses, and a warning that fires on a blip is worse
    than no warning at all.
    """
    for rrtype in ("A", "AAAA"):
        try:
            if list(resolve(name, rrtype)):
                return False
        except (dns.resolver.NoAnswer, dns.resolver.NXDOMAIN):
            continue
        except (dns.resolver.NoNameservers, dns.resolver.Timeout, MalformedNameError):
            return False
    return True


class Sweeper:
    """Walks sites -> environments -> custom domains, writing CSV rows and counting outcomes.

    Holds its collaborators (the API getter, the CSV writer, the counters) rather than threading
    them through five-parameter functions.
    """

    def __init__(self, get, writer, stream, *, verbose=False):
        self._get = get
        self._writer = writer
        # The stream is INJECTED rather than reaching for sys.stdout, so that the "flush after
        # every row" requirement (SPEC section 5) is testable: in a test the writer and
        # sys.stdout are unrelated objects, so nothing would pin the flush (SPEC section 9).
        self._stream = stream
        self._verbose = verbose
        self.counters = Counters()
        # SPEC section 7.3's "where did it stop" line.  Initialized here, not only in sweep(),
        # so report_stop() cannot raise AttributeError while reporting some other failure.
        self.last_site = ""       # the last site that COMPLETED
        # Fix round 2, N3.  "startup", not "": KeyboardInterrupt is asynchronous and can land
        # inside sweep()'s own `self.remaining = list(sites)` or `self._progress(...)` call --
        # BOTH run before `self.current_site = site["name"]` -- producing the malformed "Stopped
        # during ." otherwise (report_stop no longer has an `or 'startup'` fallback of its own,
        # per fix round 1's m7, which correctly removed it for every SYNCHRONOUS failure but
        # missed this asynchronous one).  Fixing the invariant here, at its one source, means
        # current_site is truthy for the WHOLE lifetime of a Sweeper, not just after the first
        # site's own assignment -- report_stop() needs no fallback logic of its own either way.
        self.current_site = "startup"
        self.remaining = []

    def _progress(self, message):
        if self._verbose:
            print(message, file=sys.stderr, flush=True)

    def sweep(self, sites):
        self.remaining = list(sites)
        for number, site in enumerate(sites, start=1):
            self._progress(f"[{number}/{len(sites)}] {site['name']}")
            self.current_site = site["name"]
            self.sweep_site(site)
            self.last_site = site["name"]
            self.remaining = list(sites[number:])

    def sweep_site(self, site):
        self.counters.sites += 1
        before = (self.counters.envs, self.counters.custom_domains)
        try:
            environments = site_environments(self._get, site["id"])
        except PantheonApiError as e:
            # PantheonApiShapeError is a PantheonApiError, so an unexpected shape lands here too
            # (SPEC G17).  SessionExpiredError deliberately is NOT one -- it must propagate.
            skipped(f"{site['name']}: could not list environments: {e}")
            self.counters.indeterminate += 1
            return
        for env_id in sorted(environments):
            self.sweep_env(site, env_id)
        self._progress(f"    {site['name']}: {self.counters.envs - before[0]} environments, "
                       f"{self.counters.custom_domains - before[1]} custom domains")

    def sweep_env(self, site, env_id):
        self.counters.envs += 1
        try:
            entries = self._get(f"/sites/{site['id']}/environments/{env_id}/domains")
            # INSIDE the try on purpose: partition_domains raises PantheonApiShapeError on a
            # malformed payload, and SPEC G17 says a shape error is reported "exactly like
            # G4/G5/G6 depending on which call produced it" -- i.e. one environment's
            # indeterminate, not the end of a 38-minute sweep.  Outside the try, one bad
            # payload aborted everything after it.
            custom_domains, platform_domains, unknown = partition_domains(entries)
        except PantheonApiError as e:
            skipped(f"{site['name']}.{env_id}: could not list domains: {e}")
            self.counters.indeterminate += 1
            return
        for name, kind in unknown:          # G6a
            # Quoted explicitly, not `{kind!r}`: repr() only adds quotes for a str value, so a
            # domain entry with NO `type` key at all (kind is None) rendered the unquoted
            # `unknown domain type None` -- SPEC G6a's wire format is always the quoted
            # `'<type>'` form (fix round 1, M4).
            skipped(f"{site['name']}.{env_id} {name}: unknown domain type '{kind}'; "
                    "not examined")
            self.counters.indeterminate += 1
        for custom_domain in custom_domains:
            self.counters.custom_domains += 1
            self.check_domain(site, env_id, custom_domain, platform_domains)

    def check_domain(self, site, env_id, custom_domain, platform_domains):
        where = f"{site['name']}.{env_id} {custom_domain}"
        result = walk(custom_domain)
        if result.problem:
            skipped(f"{where}: {result.problem}")
            self.counters.indeterminate += 1
            return
        if not result.platform_domain:
            return
        if result.dns_record != custom_domain:
            # SPEC G13a.  The record the downstream rewriter must change is a mid-chain alias,
            # not this site's own domain -- so rewriting it moves every other name pointing at
            # it, possibly in a zone this team does not control.
            warning(
                f"{where}: the record to change is {result.dns_record}, not the custom domain; "
                "verify who else points at it before rewriting")
        if result.platform_domain not in platform_domains:
            warning(
                f"{where}: points at {result.platform_domain}, which belongs to a different "
                f"site/environment (expected one of: "
                f"{', '.join(sorted(platform_domains)) or 'none listed'})")
        if platform_domain_is_dead(result.platform_domain):
            warning(
                f"{where}: platform domain {result.platform_domain} does not resolve; the "
                "downstream rewrite has no addresses to use")
        self._writer.writerow([site["name"], env_id, custom_domain,
                               result.dns_record, result.platform_domain])
        self._stream.flush()      # so a 38-minute sweep can be watched with tail -f
        self.counters.rows += 1


def build_arg_parser():
    parser = argparse.ArgumentParser(
        allow_abbrev=False,          # house rule: no --for -> --for-real class of foot-gun
        description="List Pantheon custom domains whose DNS still reaches a platform domain.")
    parser.add_argument("-c", "--config", default="pantheon-sitehealth-emails.toml",
                        help="TOML file to read [Pantheon].org_id from; whole-organization "
                             "sweeps only, a SITE sweep never reads it")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="per-site progress on stderr")
    parser.add_argument("site", nargs="*", metavar="SITE",
                        help="site names to sweep; default is the whole organization")
    return parser


def org_id_from_config(path):
    """[Pantheon].org_id from the TOML file.

    Deliberately NOT the main program's config engine: org_id is a literal, so tomllib is the
    whole requirement, and depending on script_context would defeat this script's standalone,
    delete-in-one-commit design.

    The type check is the config-side twin of _require_str (whole-branch review C1).  TOML is a
    typed format, so `org_id = 12345` (an unquoted value -- an ordinary typo, not hostility) hands
    back an int that reaches `quote(org_id, safe="")` in org_sites() and dies there as `TypeError:
    quote_from_bytes() expected bytes` -- an unnamed traceback at exit 1, the code SPEC section 7
    reserves for a COMPLETED sweep.  An earlier fix round's `except (KeyError, TypeError)` around
    the CALL to this function catches a wrong-typed TABLE (`Pantheon = "not-a-table"`, where the
    subscript itself raises) but never a wrong-typed VALUE, whose TypeError is raised a whole
    session later.  Raising here -- where the value is read -- lands inside that same guard and
    becomes the named StartupError with an operator-ready message.  TypeError, not a bespoke
    class, because that guard already exists and already means "unusable [Pantheon].org_id".
    """
    with Path(path).open("rb") as handle:
        org_id = tomllib.load(handle)["Pantheon"]["org_id"]
    if not isinstance(org_id, str):
        raise TypeError(
            f"[Pantheon].org_id should be a string, got {type(org_id).__name__}")
    return org_id


def build_session(notify=None):
    """The production ApiSession, over one reused connection.  Monkeypatched by the CLI tests.

    follow_redirects is left at httpx's default of False ON PURPOSE (SPEC section 3, threat
    model property (c)): the Authorization header must never be replayed to a redirect target.

    machine_token() is called BEFORE the httpx.Client is constructed (fix round 2, N10): this
    round's C1 fix made an unreadable token cache a reachable, non-fatal-to-the-process failure
    (it now raises a named MachineTokenError instead of crashing the interpreter), which means
    the client this function used to build first would have leaked -- never closed, since
    nothing held a reference to it once the exception unwound.  Resolving the token first means
    no client is ever constructed on that path at all, which is simpler than a try/except that
    closes one just to immediately re-raise.
    """
    token = machine_token()
    client = httpx.Client(timeout=HTTP_TIMEOUT, headers={"User-Agent": USER_AGENT})
    return ApiSession(client, token, notify=notify)


def main(argv):
    """Exit 0 = clean sweep, 1 = completed with indeterminates, 2 = could not complete,
    130 = interrupted (SPEC section 7).

    The exit-code discipline is the point of the structure below.  Python exits 1 on ANY
    uncaught traceback, and section 7 reserves 1 for "completed with indeterminates" -- so a
    Ctrl-C, a broken pipe, or an unexpected API shape leaking out of here would be
    indistinguishable from a healthy sweep that had a few DNS timeouts.  Every other outcome is
    routed away from 1, and the only `return 1` in the program is the indeterminate branch.

    The summary print sits INSIDE the try (residual review, finding 1 -- SPEC G19).  Outside it,
    an ENOSPC on that one line escaped main() entirely and the interpreter's shutdown flush of
    the same doomed stderr turned the run into exit **120**, with a complete CSV on stdout and
    nothing in section 7's taxonomy to describe it (measured: `find-platform-domains-dns bus-occb
    2> /dev/full > /tmp/o3.out` -> exit 120).  Inside, it becomes an ordinary abort at exit 2:
    a sweep whose outcome could not be reported has not been reported.
    """
    options = build_arg_parser().parse_args(argv)

    def note(message):                       # the G7 re-authentication note, -v only
        if options.verbose:
            print(message, file=sys.stderr, flush=True)

    try:
        require_usable_streams()
        session, sites = prepare_sweep(options, note)
    except (KeyboardInterrupt, StartupError, OSError) as e:
        # All routed through one small helper (fix round 1, m6) rather than more `return`
        # statements inline: main() already sits at ruff's PLR0911 limit by design (the module
        # docstring on prepare_sweep records why it was split out in the first place), and a bare
        # `except KeyboardInterrupt: ... return 130` here would push it back over.
        #
        # OSError added by the residual review, finding 1.  prepare_sweep() converts every OSError
        # it can NAME into a StartupError, but retrying() -- the G4a ignored-cursor line, the one
        # stderr write that happens before main() has either a Sweeper or a StartupError to report
        # (SPEC section 4.1) -- prints from inside org_sites(), and an ENOSPC there escaped main()
        # as an uncaught OSError: exit 1, the code section 7 reserves for a COMPLETED sweep.  This
        # is the startup half of the `except BaseException` last line of defence below.
        return report_startup_failure(e)

    sweeper = Sweeper(session.get, csv.writer(sys.stdout, lineterminator="\n"), sys.stdout,
                      verbose=options.verbose)
    try:
        sweeper.sweep(sites)
        print(sweeper.counters.summary(), file=sys.stderr)
    except KeyboardInterrupt:
        report_stop(sweeper, "interrupted", argv, options.site)
        return 130
    except SessionExpiredError as e:
        report_stop(sweeper, f"session expired: {e}", argv, options.site)
        return 2
    except BrokenPipeError:
        # `find-platform-domains-dns | head` is the natural first thing an operator types.
        # stderr is unaffected by a closed stdout, so the abort report is printed here too --
        # SPEC section 8 says the summary appears on EVERY path that entered the site loop.
        # report_stop() applies the os.dup2 recipe this arm used to own -- see its docstring.
        report_stop(sweeper, "stdout closed (broken pipe)", argv, options.site)
        return 2
    except SystemExit:
        raise
    except BaseException as e:  # noqa: BLE001 -- deliberate last line of defence, see the docstring: an uncaught exception here would exit 1, which section 7 reserves for a COMPLETED sweep.  It is re-reported by name, never swallowed silently (PD#2)
        report_stop(sweeper, f"unexpected {type(e).__name__}: {e}", argv, options.site)
        return 2
    return 1 if sweeper.counters.indeterminate else 0


class StartupError(Exception):
    """The sweep could not be started: SPEC G1-G4b, or a listing-time G7a. Always exit 2."""


def require_usable_streams():
    """Refuse to sweep when stdout or stderr is closed (whole-branch review I2).

    Both halves were measured, and the second is the worse one:

      * `find-platform-domains-dns bus-occb >&-` leaves `sys.stdout is None`, and
        `csv.writer(sys.stdout, ...)` sits outside every handler in main() -- `TypeError:
        argument 1 must have a "write" method`, an unnamed traceback at exit 1, which SPEC
        section 7 reserves for a COMPLETED sweep.
      * `find-platform-domains-dns its-wws-test1 2>&-` leaves `sys.stderr is None`, and
        `print(msg, file=None)` falls back to **sys.stdout** -- so every SKIPPED:/WARNING:/summary
        line lands in the CSV, exit 0, no diagnostic at all.  That is SPEC section 5's "NEVER
        write anything but CSV rows to stdout" violated silently, and the downstream
        DNS-rewriting script then eats `sites=1 envs=7 ...` as if it were a row.

    Raised as a StartupError so main() routes it through report_startup_failure() (exit 2, the
    "could not complete" code) without a seventh `return` -- main() is at ruff's PLR0911 limit by
    design.  report_startup_failure() prints with `file=sys.stderr`, which is exactly the
    "whichever stream still exists" behavior wanted here: with stderr gone, CPython's print()
    falls back to stdout, so the operator still sees one line naming the problem.  That single
    line is a deliberate, one-off exception to section 5 -- the alternative is total silence,
    which is PD#1.
    """
    if sys.stdout is None:
        raise StartupError("standard output is closed; there is nowhere to write the CSV")
    if sys.stderr is None:
        raise StartupError(
            "standard error is closed; every operator message would land in the CSV on stdout")


def report_startup_failure(e):
    """Print the right operator-facing message for a prepare_sweep()-time failure, and return
    the matching exit code.

    Fix round 1, m6.  KeyboardInterrupt during prepare_sweep() (site listing: up to 5 pages plus
    two 2-second cursor retries, SPEC section 4.1 -- a real Ctrl-C window) previously had no
    handler at all, so it propagated as a raw Python traceback; CPython exits 130 on an uncaught
    KeyboardInterrupt at the top level, so the exit-code contract already held, but the operator
    got a traceback instead of the program's own message shape.  There is no Sweeper yet at this
    point -- the same "nothing to count" state SPEC section 8 already carves out for G1-G4b --
    so this is the smallest message that is still visible (PD#1) without inventing counts that
    don't exist. Split into its own function, rather than two more `return` statements inline in
    main(), because main() already sits at ruff's PLR0911 limit by design (see prepare_sweep's
    own docstring below for why it was split out in the first place).

    Written through report_line() rather than print() (residual review, finding 1): this is one
    of the two ends of the road, so an ENOSPC on ITS own stderr write has nowhere to propagate --
    measured `./find-platform-domains-dns -c /dev/null 2> /dev/full` -> exit 120, outside SPEC
    section 7's taxonomy.
    """
    if isinstance(e, KeyboardInterrupt):
        report_line("ERROR: interrupted before the sweep began")
        return 130
    report_line(f"ERROR: {e}")
    return 2


def org_id_or_startup_error(config_path):
    """org_id_from_config(config_path), with every failure named as SPEC G1's StartupError.

    Its own function rather than inline in prepare_sweep(): whole-branch review m1 made the call
    conditional, and a conditional wrapped around two try/except blocks pushes prepare_sweep()
    over ruff's C901 complexity limit -- the same reason prepare_sweep() itself was split out of
    main().
    """
    try:
        return org_id_from_config(config_path)
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as e:
        # UnicodeDecodeError is NOT an OSError: a config that is not valid UTF-8 raised it
        # uncaught, which exits 1 -- the code SPEC section 7 reserves for a COMPLETED sweep.
        raise StartupError(f"could not read {config_path}: {e}") from e
    except (KeyError, TypeError) as e:
        # KeyError covers a missing [Pantheon] table or org_id key.  TypeError covers BOTH
        # `Pantheon = "not-a-table"` (where ["Pantheon"]["org_id"] subscripts a string) and, since
        # whole-branch review C1, a wrong-TYPED org_id -- org_id_from_config() now raises it
        # rather than letting an int reach quote() a whole session later.
        raise StartupError(f"{config_path} has no usable [Pantheon].org_id ({e!r})") from e


def prepare_sweep(options, note):
    """Config -> session -> site list, or StartupError with an operator-ready message.

    Split out of main() so that main() is a readable dispatch of exit codes: with this inline,
    main() carried 9 returns and a cyclomatic complexity of 12, over ruff's PLR0911/C901 limits.
    Every failure here means the same thing to the caller -- the sweep never started, exit 2 --
    so collapsing them into one named error loses nothing.
    """
    # Read the config ONLY on the whole-organization path (whole-branch review m1).  named_sites()
    # resolves each SITE argument through /site-names/{name} and never touches org_id, so
    # requiring it there made `find-platform-domains-dns bus-occb` fail exit 2 from any directory
    # without the default config -- a gate on a value that run does not consume.  The org path is
    # the only one that builds an /organizations/{org_id}/ URL, and its G1 gate is unchanged.
    org_id = "" if options.site else org_id_or_startup_error(options.config)
    try:
        session = build_session(notify=note)
    except (MachineTokenError, PantheonApiError, OSError) as e:
        # OSError, belt-and-braces (fix round 1, C1): machine_token() now converts every OSError
        # it can reach into a named MachineTokenError, but this guard means a future OSError from
        # anywhere else in build_session() -- e.g. httpx.Client construction -- still routes to
        # exit 2 rather than an uncaught traceback, instead of relying solely on machine_token()
        # never missing a case.
        raise StartupError(str(e)) from e
    try:
        sites = (named_sites(session.get, options.site) if options.site
                 else org_sites(session.get, org_id))
    except (PantheonApiError, SiteListingError, SessionExpiredError) as e:
        raise StartupError(f"could not list sites: {e}") from e
    return session, sites


def option_strings_taking_a_value():
    """Every option string that consumes a following argument, derived from the parser itself.

    Derived rather than hardcoded, for the reason psh/lifecycle.py's namesake records: a
    hardcoded list rots the first time an option is added, and resume_command() would then
    mistake that option's VALUE for a site name and delete it.
    """
    return {
        opt
        for action in build_arg_parser()._actions  # noqa: SLF001 -- argparse exposes value-taking options only via the private _actions list
        if action.option_strings and action.nargs != 0
        for opt in action.option_strings
    }


def resume_command(argv, original_sites, names):
    """The SPEC section 7.3 resume command: this invocation, with `names` in place of its SITE
    positionals.

    Whole-branch review m2.  This line used to be a bare `find-platform-domains-dns <names...>`,
    rebuilt from nothing: every flag the operator actually passed was discarded.  An operator who
    ran `-c prod.toml` pasted a command that reads a DIFFERENT config file -- silently sweeping
    another organization -- and one who ran `-v` lost the only liveness signal on the 38-minute
    re-run.  The main program rebuilds its own abort hint from sys.argv for exactly this reason
    (CLAUDE.md section Database); psh/lifecycle.py's rerun_command() is the shape copied here.

    `argv` is main()'s own argument list, i.e. sys.argv[1:] in production.  The program name is
    the PROGRAM_NAME literal rather than sys.argv[0] because section 7.3 specifies that spelling
    and because sys.argv[0] is the test runner's path whenever main() is driven in-process.

    Only POSITIONAL site names are dropped: a site name sitting in an option's value slot
    (`-c beta`) must survive, or `-c` swallows the next token and the pasted command is mangled.

    Residual review, finding 2.  The dropped token is identified by MEMBERSHIP in
    `original_sites` -- argparse's own parse of this argv, i.e. `options.site` -- exactly as
    psh/lifecycle.py's rerun_command() does it.  A "does not start with `-`" test instead deleted
    the VALUE of any short-option BUNDLE, because the bundle is not itself an option string:
    `-vc prod.toml s1 s2` rebuilt as `find-platform-domains-dns -vc s2`, which re-parses as
    `--config=s2` with no site names at all -- a whole-organization sweep against a config file
    named `s2`, and the site list this line exists to hand the operator is gone.

    Residual inherited from that model, written down rather than fixed (residual round 2): a
    value that is the SAME STRING as a site name still confuses it, because the membership test
    cannot tell the two apart -- `['-vc', 's2', 's1', 's2']` (a config file literally named `s2`)
    rebuilds as `-vc s2`, the same wrong shape.  psh/lifecycle.py:386-390 has the identical
    shape and the identical residual; fixing it needs argparse's own token classification rather
    than a membership test, which is not worth it in a script due for deletion.
    """
    value_options = option_strings_taking_a_value()
    kept = []
    previous = None
    for arg in argv:
        if previous not in value_options and arg in original_sites:
            previous = arg
            continue                      # a SITE positional: `names` replaces all of them
        kept.append(arg)
        previous = arg
    return shlex.join([PROGRAM_NAME, *kept, *names])


def detach_doomed_stdout():
    """Point sys.stdout's file descriptor at /dev/null so the interpreter's shutdown flush of it
    cannot raise -- and cannot therefore override this program's exit code with 120.

    The recipe is Python's own, from the "Note on SIGPIPE" in the library/signal docs.  Called
    only from report_stop(), i.e. only on a path that is already aborting.

    The flush is attempted for real, and the descriptor is replaced ONLY when that flush fails.
    Both halves of that are load-bearing:

      * Flushing first means a healthy stdout still holding a row (an abort landing between
        writerow() and the per-row flush) writes that row instead of losing it to /dev/null --
        SPEC section 1 names a missing row as the expensive failure.
      * Replacing only on failure means an abort with a perfectly good stdout has NO global
        side effect.  An unconditional dup2 here silences every later write to that descriptor,
        which is not hypothetical: under pytest's default fd-level capture it repoints the
        session's captured stdout at /dev/null, and every subsequent test errors with EBADF
        (measured: 19 errors).  A guard whose only red-capable test would have to disable the
        harness is PD#14 in its most literal form.

    A flush that fails is exactly the condition being defended against, and a flush that
    succeeds proves there is nothing left for the shutdown flush to choke on -- 120 can only
    arise when there is pending data that cannot be written.
    """
    try:
        sys.stdout.flush()
    except (OSError, ValueError):
        point_at_devnull(sys.stdout)


def point_at_devnull(stream):
    """Repoint `stream`'s file descriptor at /dev/null, so nothing written to it can fail again.

    The shared half of detach_doomed_stdout() and detach_doomed_stderr(); the recipe is Python's
    own, from the "Note on SIGPIPE" in the library/signal docs.  Callers decide WHETHER a stream
    is doomed -- this only carries it out, and it is never called on a stream that is working.

    suppress(), not try/except/pass: ruff SIM105.  Named exceptions only (PD#2) -- a broad
    suppression would hide a real dup2 failure.  ValueError/io.UnsupportedOperation are the
    "not backed by a real file descriptor" shapes (pytest's capsys object raises
    io.UnsupportedOperation from fileno()), where there is no descriptor to replace at all.
    """
    with contextlib.suppress(OSError, ValueError, io.UnsupportedOperation):
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, stream.fileno())
        os.close(devnull)


def detach_doomed_stderr():
    """The stderr twin of detach_doomed_stdout(): point the operator stream that just failed at
    /dev/null, so neither this program's own remaining messages nor the interpreter's shutdown
    flush can raise again and override the exit code with 120 (SPEC G19).

    It holds the SAME load-bearing property as its stdout sibling -- NEVER detach a stream that
    is working -- but it proves the stream is doomed a different way, and the difference is
    measured rather than stylistic.  detach_doomed_stdout() probes with a real flush because
    nothing has tried to write yet and a stdout still holding a row must get its chance to write
    it.  A flush probe is worthless here: sys.stderr is LINE-buffered, so its buffer is empty at
    the moment of the probe on every path where no earlier stderr write has already failed, and
    an empty flush succeeds on a filesystem that is 100% full -- it would report a doomed stream
    healthy.  Measured: with a flush probe `find-platform-domains-dns -c /dev/null 2> /dev/full`
    still exits 120; with this one it exits 2.  So the probe here is the caller's own failed
    write: report_line() is the ONLY caller, and it calls this only from the except arm of a
    print that really raised.

    sys.stdout, when stderr is closed: CPython's `print(..., file=None)` falls back to sys.stdout
    (the fallback require_usable_streams() already documents), so on `2>&- > /dev/full` -- G0
    reporting its own abort onto a full stdout -- stdout is the stream that just failed.
    Measured: exit 120 without this arm, exit 2 with it.
    """
    point_at_devnull(sys.stdout if sys.stderr is None else sys.stderr)


def report_line(text):
    """One line of an abort report, written to a stderr that may itself be failing (SPEC G19).

    Every OTHER stderr write in this program is deliberately unguarded -- skipped(), warning(),
    retrying(), Sweeper._progress(), main()'s -v note and its summary line all let an OSError
    propagate, because main()'s handlers turn it into a named abort at exit 2.  This is the end
    of that road: a failure HERE has nowhere left to propagate.  It escapes main() as an uncaught
    OSError, and CPython's shutdown flush of the same doomed stream then overrides the exit code
    with **120**, which SPEC section 7's taxonomy does not contain -- so a `case $?` over
    0/1/2/130 in a cron wrapper falls through.  Measured live, all three before the guard:

        $ ./find-platform-domains-dns bus-occb    2> /dev/full > /tmp/o3.out  -> exit 120
        $ ./find-platform-domains-dns -v bus-occb 2> /dev/full > /tmp/o4.out  -> exit 120, and
                                                    /tmp/o4.out EMPTY: the sweep died at the
                                                    first progress line and nothing said so
        $ ./find-platform-domains-dns -c /dev/null 2> /dev/full               -> exit 120

    Swallowing the OSError is the point: there is nowhere to report "I could not report", and the
    exit code is the only channel left (PD#1 -- the failure stays visible in the code, not in
    prose).  The stream is detached so that the REST of the abort report, and the interpreter's
    own shutdown flush, are no-ops rather than repeat failures.
    """
    try:
        print(text, file=sys.stderr, flush=True)
    except (OSError, ValueError):
        detach_doomed_stderr()


def report_stop(sweeper, reason, argv, original_sites):
    """SPEC section 7.3: an aborted sweep MUST say where it stopped, or the operator has no way
    to resume except starting the 38-minute sweep over.

    Unconditional on purpose.  An earlier draft printed the position only `if sweeper.last_site`
    -- i.e. never, when the very first site was the one interrupted, which is precisely when an
    operator most needs to know where they are.  And it printed a COUNT of unreached sites
    rather than their names, which is not a recovery instruction: the order is ascending by site
    UUID and the operator has no copy of that list.  The names are already in hand.

    Sets SIGINT to SIG_IGN before printing (fix round 1, m5): a second Ctrl-C landing mid-print
    here could truncate the resume line, which is the whole recovery story per the paragraph
    above.  Mirrors the main program's own abort_run() (CLAUDE.md section Database: "sets SIGINT
    to SIG_IGN so a second Ctrl-C cannot truncate the flush").  A test driving this in-process
    MUST monkeypatch signal.signal, or SIG_IGN persists for the REST of that pytest session --
    signal handlers are process-global and are not restored automatically (the identical trap
    CLAUDE.md's Testing section documents for abort_run()).

    Also detaches a doomed sys.stdout from the interpreter's shutdown flush (whole-branch review
    I1).  That recipe used to live in main()'s BrokenPipeError arm alone, but the mechanism is not
    pipe-specific: CPython re-flushes sys.stdout at shutdown, ANY failure of that flush is turned
    into exit **120** plus an "Exception ignored on flushing sys.stdout" message, and 120 is not in
    SPEC section 7's taxonomy.  Measured live: `find-platform-domains-dns bus-occb > /dev/full`
    printed a correct named message, the summary and this whole report -- then exited 120.  A full
    disk or an over-quota redirect target on a 38-minute org-wide CSV is ordinary, and it arrives
    through main()'s `except BaseException` arm, not the BrokenPipeError one.  report_stop() is
    the one function EVERY exit-2/130 abort path calls, so it is the one place the recipe belongs.

    Every line goes out through report_line() rather than print() (residual review, finding 1),
    which is the same defence pointed at the OTHER stream: with stderr doomed, the very first
    print here raised INSIDE main()'s except handler, so the exit code went to 120 and the resume
    line -- the whole recovery story of SPEC section 7.3 -- was never printed at all.  See
    report_line() and detach_doomed_stderr() for why stderr needs a different probe from stdout.
    """
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    detach_doomed_stdout()
    report_line(f"ERROR: sweep did not complete ({reason})")
    report_line(sweeper.counters.summary())
    if sweeper.last_site:
        report_line(f"Stopped after {sweeper.last_site}.")
    else:
        # No `or 'startup'` fallback needed here (fix round 1, m7 removed one; fix round 2, N3
        # corrects that removal): current_site is truthy for a Sweeper's WHOLE lifetime, because
        # `Sweeper.__init__` seeds it with the "startup" placeholder itself, not "".  m7's
        # original reasoning -- "sweep() sets current_site before sweep_site() is ever called, so
        # it cannot be falsy here" -- holds only for SYNCHRONOUS failures; a KeyboardInterrupt is
        # asynchronous and can land inside sweep()'s own `self.remaining = list(sites)` or
        # `self._progress(...)` call, both of which run before the per-site assignment, which is
        # exactly how "Stopped during ." (malformed) was reproduced.
        report_line(f"Stopped during {sweeper.current_site}.")
    if sweeper.remaining:
        count = len(sweeper.remaining)
        command = resume_command(argv, original_sites,
                                 [site["name"] for site in sweeper.remaining])
        report_line(f"{count} site{'' if count == 1 else 's'} not reached. Resume with:\n"
                    f"  {command}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
