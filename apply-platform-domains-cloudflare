class StartupError(Exception):
    """Anything that stops the run from starting or completing (exit 2)."""


class InvariantError(StartupError):
    """A mid-run INTERNAL INVARIANT violated -- not an operator error (SPEC 9.1).

    Raised when an entry reaches pass 3 without a `ready` verdict, when a delete id pass 1
    never resolved, or when a `delete_match`/`posts` shape the section 6 checks should already
    have rejected reaches a body builder anyway.  A subclass of StartupError so main()'s existing
    handler and the exit-2 taxonomy stay unchanged -- this adds a NAME, not a new code path
    (PD#2): reaching this point means the upstream gate has a bug, and silently proceeding is
    exactly the failure class PD#1 forbids.
    """


class OutputWriteError(StartupError):
    """The run record could not be written or could not be serialized (SPEC 9.1/9.2).

    A subclass of StartupError for the same reason InvariantError is: main()'s existing handler
    and the exit-2 taxonomy stay unchanged -- this adds a NAME, not a code path.  Named rather
    than reusing OSError because the failure is not always an OS-level one: json.dump raises
    TypeError/ValueError on an unserializable value, and calling that an OSError would be exactly
    the "handle errors" mis-naming PD#2 forbids.  Unlike the sibling's four-output-file version of
    this class, this script writes exactly ONE artifact -- the run record beside FILE -- so there
    is no partial-set report to relay; see SPEC 9.2 for the precedence rule this exception feeds.
    """


def point_at_devnull(stream) -> None:
    """Repoint `stream`'s file descriptor at /dev/null, so nothing written to it can fail again.

    Copied verbatim from find-platform-domains-dns; the recipe is Python's own, from the "Note on
    SIGPIPE" in the library/signal docs.  Callers decide WHETHER a stream is doomed -- this only
    carries it out, and it is NEVER called on a stream a real write has not already failed on.

    suppress(), not try/except/pass: ruff SIM105.  Named exceptions only (PD#2) -- a broad
    suppression would hide a real dup2 failure.  ValueError/io.UnsupportedOperation are the "not
    backed by a real file descriptor" shapes (pytest's capture objects raise
    io.UnsupportedOperation from fileno()), where there is no descriptor to replace at all.
    """
    with contextlib.suppress(OSError, ValueError, io.UnsupportedOperation):
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, stream.fileno())
        os.close(devnull)


def report_line(text) -> None:
    """One line of an abort report, written to a stderr that may itself be failing.

    Every OTHER stderr write in this script is deliberately unguarded -- the progress notes, the
    re-read warnings and the summary all let an OSError propagate, because main()'s handlers turn
    it into a named abort at exit 2.  This is the end of that road: a failure HERE has nowhere
    left to propagate, and CPython's shutdown flush of the same doomed stream would override the
    exit code with 120.  Swallowing the OSError is the point -- there is nowhere to report "I
    could not report", and the exit code is the only channel left.

    The probe is the caller's own failed write, never a flush: sys.stderr is LINE-buffered, so its
    buffer is empty at probe time and an empty flush succeeds even on a filesystem that is 100%
    full -- it would report a doomed stream healthy.  With sys.stderr closed, CPython's
    print(file=None) falls back to sys.stdout, so stdout is then the stream that just failed.
    """
    try:
        print(text, file=sys.stderr, flush=True)
    except OSError:
        point_at_devnull(sys.stdout if sys.stderr is None else sys.stderr)


def write_report(text) -> None:
    """One line of the report -- EVERY stdout write in this script MUST go through this, not a
    bare print() (SPEC 11.1, added by the task 7 review).

    `report_line` is stdout's counterpart on stderr; this is stdout's own.  CPython's shutdown
    flush covers BOTH standard streams and turns a failure of EITHER into exit 120, overriding
    whatever main() returned -- so an `except OSError` arm that correctly computes exit 2 is
    silently overridden by the interpreter unless the doomed stream is detached FIRST.  Unlike
    report_line (the end of the road, where swallowing is the point), a failed report write is
    NOT swallowed: it is detached immediately, right here, and re-raised as a StartupError so
    main()'s existing handler names it and returns 2 -- the interpreter's later shutdown flush
    then hits an already-devnull-backed fd and succeeds, so 2 is what survives.  This is the
    THIRD appearance of this exact bug class in this script family; CLAUDE.md records the other
    two (find-platform-domains-dns's report_line, find-platform-domains-cloudflare's
    write_json_stdout).
    """
    try:
        print(text, flush=True)
    except OSError as e:
        point_at_devnull(sys.stdout)
        raise StartupError(
            f"cannot write the report to standard output: {type(e).__name__}: {e}") from e


class PlanFileError(StartupError):
    """The input file is not a plan or revert file this script knows how to apply (SPEC 6).

    A subclass of StartupError so main()'s existing handler and the exit-2 taxonomy stay
    unchanged -- this adds a NAME, not a code path (PD#2).  Every one of SPEC section 6's eight
    checks raises this, and every message names the file, the FQDN key where one applies, and
    the offending field.  Fatal rather than per-entry-skippable BY DESIGN: a file malformed in
    one entry is a file whose provenance is in question, and partially applying it is exactly
    what SPEC section 3's first property exists to prevent.
    """


class CloudflareReadError(StartupError):
    """A DNS-record LIST call failed during pass 1 (SPEC 9.1).

    Pass 1 is read-only, so this always means nothing was changed -- hence exit 2 and a
    StartupError subclass.  A list failure during POST-APPLY VERIFICATION is NOT this: by then
    Cloudflare has been written to, so it is a VerifyError and the run exits 3.
    """


class ApplyError(Exception):
    """A batch call was REJECTED -- Cloudflare committed nothing for this entry (SPEC 9.1, 8.1).

    Deliberately NOT a StartupError subclass: those all mean exit 2 ("nothing was changed"), and
    this one can mean exit 2 or exit 3 depending on whether an EARLIER entry in the same run
    already applied -- main() computes the code from the outcome tally (exit_code_for), never
    from the exception class alone.

    Raised ONLY for a rejected batch call (a real Cloudflare 4xx/5xx, not a dropped connection).
    A batch call that RETURNED but did not verify -- where Cloudflare committed SOMETHING and only
    our confirmation of it is in doubt -- is the distinct `VerifyError` subclass below, never this
    base class directly: SPEC 8.1's four-state table (`applied`/`unverified`/`failed`/`unknown`)
    needs a signal `apply_all` can actually branch on, not just a shared string message, or
    "rejected, nothing committed" and "committed but unconfirmed" collapse into the same `failed`
    outcome -- exactly the contradiction that made R6.3's own exit-3 claim false before the
    `unverified` outcome existed (Task 8 review, Item A).
    """


class VerifyError(ApplyError):
    """The batch call RETURNED (so Cloudflare committed something), but the post-apply
    verification could not confirm what (SPEC R6.3, 8.1, 9.1).

    Raised for the two SPEC R6.3 triggers: a verification-read call itself failing outright, or a
    mismatch surviving the single retry.  A subclass of `ApplyError`, not a sibling, so
    `pytest.raises(ApplyError, ...)` and any future generic `except ApplyError` still catch it --
    but `apply_all` MUST catch THIS class before the plain `ApplyError` clause, or a rejected batch
    and a committed-but-unconfirmed one collapse into the same `failed` outcome again.
    """


def require_usable_streams() -> None:
    """Refuse to run when either standard stream is closed.

    Adapted from find-platform-domains-cloudflare's function of the same name, with its `output`
    parameter REMOVED: that script writes its result to stdout only when -o is absent, so a
    closed stdout is survivable there.  This script always writes the report to stdout and always
    writes ATTENTION/ERROR lines to stderr, so both are unconditionally required.

    The stderr case is the dangerous one, and it is measured: CPython's print(msg, file=None)
    falls back to sys.stdout, so with `2>&-` every ATTENTION line -- the ONLY signal that a
    destructive run was refused or narrowed -- would be interleaved into the report on stdout.

    Raised as a StartupError so main()'s handler reports it at exit 2.
    """
    if sys.stdout is None:
        raise StartupError(
            "standard output is closed; there is nowhere to write the report of what this run "
            "would change")
    if sys.stderr is None:
        raise StartupError(
            "standard error is closed; every ATTENTION and ERROR line would fall back to stdout "
            "and be mixed into the report there")


def normalize(name):
    """Lowercase, strip whitespace and the trailing root dot.  Copied from
    find-platform-domains-dns."""
    return str(name).strip().rstrip(".").lower()


def dump_json(data, stream) -> None:
    """The ONE serialization of the output mapping, so the -o file and stdout are byte-identical
    (SPEC A1.5).  Two call sites formatting separately is how the two destinations drift."""
    json.dump(data, stream, indent=4, sort_keys=True)
    stream.write("\n")


def now_utc():
    """The one clock seam, as an ISO-8601 Z-suffixed string; tests monkeypatch it (SPEC 7).

    A seam rather than a post-hoc normalization: a golden that strips the timestamp before
    comparing is no longer comparing the bytes the program wrote (PD#14).
    """
    return datetime.datetime.now(tz=datetime.UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def write_json_atomic(path, data) -> None:
    """Write data as JSON to a temp file in the same directory, then os.replace() it onto `path`.

    Copied from plugin/cloudflare/fqdns.py's write_fqdns_atomic.  Atomic: an interrupted write
    never leaves a half-written or truncated output file -- the previous one stays byte-intact.
    """
    directory = os.path.dirname(os.path.abspath(path)) or "."  # noqa: PTH120, PTH100 --
    # feeds tempfile.mkstemp's dir=, load-bearing for the atomic-rename-needs-same-filesystem
    # guarantee this docstring documents; Path.resolve() follows symlinks where
    # os.path.abspath() does not, a real semantic difference for the symlink case
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".apply-platform-domains-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            dump_json(data, f)   # the SAME serializer stdout uses, so the two cannot drift
        # mkstemp creates the temp file mode 0600, which os.replace would preserve; restore a
        # normal umask-based mode (typically 0644) so other readers keep their access.
        current_umask = os.umask(0)
        os.umask(current_umask)
        os.chmod(tmp, 0o666 & ~current_umask)  # noqa: PTH101 -- behavior surface, see above
        os.replace(tmp, path)  # noqa: PTH105 -- THE atomic-replace call this docstring documents
    except BaseException:  # incl. KeyboardInterrupt: drop the temp file, leave the old one intact
        try:  # noqa: SIM105 -- not restructuring the BaseException cleanup handler's flow
            os.unlink(tmp)  # noqa: PTH108 -- cleanup path of the same behavior surface
        except FileNotFoundError:
            pass
        raise


def read_apply_file(path):
    """Parse the input file.  Every failure is a PlanFileError naming the path (SPEC 6, 1)."""
    try:
        with Path(path).open("rb") as handle:
            doc = json.load(handle)
    except OSError as e:
        raise PlanFileError(f"cannot read {path}: {e}") from e
    except ValueError as e:
        # ValueError, not JSONDecodeError: json.load decodes the bytes itself, so a file that is
        # not valid UTF-8 raises UnicodeDecodeError -- NOT a JSONDecodeError.  Both are
        # ValueError subclasses, so one clause closes the CLASS rather than the instance.  The
        # sibling shipped this exact defect three times before closing it the same way.
        raise PlanFileError(f"{path} is not valid JSON: {e}") from e
    if not isinstance(doc, dict):
        raise PlanFileError(f"{path} is not a JSON object (got {type(doc).__name__})")
    return doc


def check_record_list(items, where):
    """SPEC section 6 checks 7 and 8: a non-empty list of {type, name, content} in scope."""
    if not isinstance(items, list) or not items:
        raise PlanFileError(f"{where}: must be a non-empty list")
    for index, item in enumerate(items):
        if not isinstance(item, dict):
            raise PlanFileError(f"{where}[{index}]: not an object")
        for field in ("type", "name", "content"):
            if not item.get(field):
                raise PlanFileError(f"{where}[{index}]: missing '{field}'")
        if item["type"] not in GOVERNED_TYPES:
            raise PlanFileError(
                f"{where}[{index}]: type must be one of {', '.join(GOVERNED_TYPES)}, got "
                f"{item['type']!r}")


def check_entry_contract(fqdn, entry, path):
    """SPEC section 6 checks 4-8, for one entry.

    Split out of check_file_contract so the per-file checks (2-3) and the per-entry checks
    (4-8) each stay under ruff's C901 complexity cap -- a mechanical split, not a behavior
    change: the messages and the `path entry fqdn` prefix are unchanged.
    """
    where = f"{path} entry {fqdn}"
    if not isinstance(entry, dict):
        raise PlanFileError(f"{where}: not an object")
    for field in ("zone_id", "method", "path", "body", "delete_match"):
        if field not in entry:
            raise PlanFileError(f"{where}: missing required field '{field}'")
    if entry["method"] != "POST":
        raise PlanFileError(
            f"{where}: method must be 'POST', got {entry['method']!r}")
    expected_path = f"/zones/{entry['zone_id']}/dns_records/batch"
    if entry["path"] != expected_path:
        raise PlanFileError(
            f"{where}: path must be {expected_path!r} (built from this entry's own "
            f"zone_id), got {entry['path']!r}")
    body = entry["body"]
    if not isinstance(body, dict):
        raise PlanFileError(f"{where}: body must be an object")
    if "deletes" in body:
        raise PlanFileError(
            f"{where}: body must not contain 'deletes' -- record ids are resolved against "
            "Cloudflare at apply time, so any ids baked into the file cannot be correct")
    check_record_list(body.get("posts"), f"{where} body.posts")
    check_record_list(entry["delete_match"], f"{where} delete_match")


def check_file_contract(doc, path):
    """SPEC section 6's eight checks, in order.  Returns the direction.

    Fatal rather than per-entry: a file malformed in one entry is a file whose provenance is in
    question.  After this returns, every entry is known to carry zone_id/method/path/body/
    delete_match, a POST to its own zone's batch path, a non-empty `posts` with no `deletes`
    beside it, and only CNAME/A/AAAA types -- which is what makes GOVERNED_TYPES total downstream.
    """
    generated = doc.get("generated")
    direction = generated.get("direction") if isinstance(generated, dict) else None
    if direction == "excluded":
        raise PlanFileError(
            f"{path} is an EXCLUDED file (generated.direction is 'excluded'), not a plan or a "
            "revert.  An excluded file records why FQDNs got no rewrite instructions; it carries "
            "no request body and there is nothing to apply.")
    if direction not in ("plan", "revert"):
        raise PlanFileError(
            f"{path}: generated.direction must be 'plan' or 'revert', got {direction!r}")

    entries = doc.get("entries")
    if not isinstance(entries, dict) or not entries:
        raise PlanFileError(f"{path} has no entries to apply")

    for fqdn, entry in sorted(entries.items()):
        check_entry_contract(fqdn, entry, path)
    return direction


def select_entries(entries, only):
    """SPEC R7.  Without --only, everything; with it, exactly the named FQDNs.

    EVERY unmatched name is named, not just the first: a typo that silently narrows a destructive
    run is the under-reporting failure this family of scripts refuses to have (R7.3).  Unselected
    entries are never validated and never counted as anything but "in the file" (R7.2a) --
    validating an entry the run will not touch would let an unrelated FQDN's drift abort a
    deliberately narrow, safe run.
    """
    if only is None:
        return dict(entries)
    wanted = [normalize(name) for name in only]
    missing = [name for name in wanted if name not in entries]
    if missing:
        raise StartupError(
            "--only named "
            + ("an FQDN that is not" if len(missing) == 1 else "FQDNs that are not")
            + " in this file: " + ", ".join(sorted(missing)))
    return {fqdn: entries[fqdn] for fqdn in entries if fqdn in set(wanted)}


def record_key(rtype, name, content):
    """The comparison key for one DNS record (SPEC 7.1).

    Addresses are compared as ipaddress VALUES, not strings: 2620:12a:8000::4 and
    2620:12A:8000:0:0:0:0:4 are one address written two ways, and a string comparison would call
    them two records -- inventing a partially-applied verdict on a healthy zone.  Names and CNAME
    targets go through normalize(), so case and a trailing dot never split a key.  Cloudflare's
    own name/content list filters are documented CASE-INSENSITIVE, so what the filter returns is
    re-checked here regardless of what it matched.
    """
    rtype = str(rtype).upper()
    if rtype in ("A", "AAAA"):
        try:
            canonical = str(ipaddress.ip_address(str(content).strip()))
        except ValueError:
            # Not an address at all.  Keep it as text rather than raising: this is a comparison
            # key, and a record Cloudflare returned with unparseable content must still be
            # comparable (it will simply not equal anything the file describes, which is the
            # correct outcome -- an invalid verdict naming it).
            canonical = normalize(content)
    else:
        canonical = normalize(content)
    return (rtype, normalize(name), canonical)


def governed_records(rows):
    """The records at a name that this script reasons about (SPEC R1.1).

    Everything else -- TXT, MX, CAA -- is ignored entirely: never read as state, never deleted,
    never counted.  A site's SPF record must not be able to make a rewrite look drifted.
    """
    return [r for r in rows if str(getattr(r, "type", "")).upper() in GOVERNED_TYPES]


def describe_keys(keys):
    """Render record keys for an operator message."""
    return ", ".join(f"{rtype} {content}" for rtype, _name, content in keys)


def want_delete_keys(entry):
    """SPEC 7.2's D, as `record_key()`s -- the ONE derivation, shared by `verdict_for` and
    `validate_entries` (task 5 review, Important 4).

    Before this helper existed, both functions computed D independently from `entry
    ["delete_match"]`.  A hand-edit to one that missed the other could make a `ready` verdict
    silently resolve fewer delete ids than `delete_match` actually names -- pass 3 would then
    DELETE PART of D and POST P, exactly the partial write SPEC section 3 exists to prevent.
    Routing both through this one function makes that class of drift structurally impossible
    rather than merely unlikely.
    """
    return {record_key(item["type"], item["name"], item["content"])
            for item in entry["delete_match"]}


def verdict_for(entry, rows):
    """Classify one entry against Cloudflare's current state (SPEC 7.3).  Returns (verdict,
    detail); detail is "" only for the two valid verdicts.

    The whole decision is WHICH SET R equals.  Evaluation order is the table's order and row 1 is
    first for a reason: set() collapses duplicates, so a duplicated key would let R == D succeed
    on a name that actually holds the record twice.

    SPEC 7.4's nil shadow: an empty/absent `delete_match` or `body.posts` is supposed to be
    UNREACHABLE, because section 6 checks 7 and 8 already made it fatal before pass 1 -- but that
    is an invariant about the caller, not something this function can assume without checking.
    Without this guard, an entry with both empty AND an empty `rows` (R) would fall through to
    `have == want_delete` on two empty sets and return a false "ready" -- indistinguishable from a
    healthy, fully-processed entry.  Asserted here, not assumed (PD#1/PD#14).  `.get(...)`, not
    `entry[...]`: a key ABSENT entirely (not merely empty) must raise this SAME named
    InvariantError too, not a bare unnamed KeyError (review round 2, item 2).
    """
    if not entry.get("delete_match") or not entry.get("body", {}).get("posts"):
        raise InvariantError(
            "verdict_for: entry has an empty or missing delete_match/body.posts -- section 6 "
            "checks 7 and 8 should have made this fatal before pass 1 ever ran")
    present = governed_records(rows)
    keys = [record_key(r.type, r.name, r.content) for r in present]
    duplicates = sorted({key for key in keys if keys.count(key) > 1})
    if duplicates:
        # SPEC 7.3 (amended, review round 2 controller ruling): record-ambiguous is the ONE
        # verdict whose detail must name record ids, not just record_key terms -- by
        # construction the colliding records SHARE a record_key (that is what makes them
        # ambiguous), so a detail in record_key terms alone cannot tell them apart, and the id
        # is the only field that distinguishes them in the dashboard or API.  `present`/`keys`
        # are already same-scope locals in parallel order, so this is a same-scope filter, not
        # a signature change to record_key (which stays deliberately id-less for the set
        # comparison, SPEC 7.1).
        ids_by_key = {}
        for record, key in zip(present, keys, strict=True):
            if key in duplicates:
                ids_by_key.setdefault(key, []).append(str(record.id))
        collisions = "; ".join(
            f"{describe_keys([key])} (record ids: {', '.join(ids_by_key[key])})"
            for key in duplicates)
        return ("record-ambiguous",
                f"more than one record at this name with the same type and content: "
                f"{collisions}")

    have = set(keys)
    want_delete = want_delete_keys(entry)
    want_post = {record_key(item["type"], item["name"], item["content"])
                 for item in entry["body"]["posts"]}

    if have == want_delete:
        return ("ready", "")
    if have == want_post:
        return ("already-applied", "")
    if have & want_delete and have & want_post:
        return ("partially-applied",
                f"Cloudflare holds a MIX of the records to delete and the records to create: "
                f"{describe_keys(sorted(have))}")
    for expected, side in ((want_delete, "to delete"), (want_post, "to create")):
        if have > expected:
            return ("unexpected-records",
                    f"Cloudflare holds every record {side} plus "
                    f"{describe_keys(sorted(have - expected))}, which this entry does not "
                    "describe")
    return ("records-missing",
            f"Cloudflare holds {describe_keys(sorted(have)) or 'no CNAME/A/AAAA record'} at this "
            f"name; expected either {describe_keys(sorted(want_delete))} (not yet applied) or "
            f"{describe_keys(sorted(want_post))} (already applied)")


class Validation(NamedTuple):
    """One entry's pass-1 result.  `delete_ids` is non-empty only for a `ready` verdict."""

    verdict: str
    detail: str
    delete_ids: list


def records_at_name(client, zone_id, fqdn):
    """Every DNS record Cloudflare holds at one name (SPEC 7.1).

    ONE filtered list call per FQDN -- but NOT one HTTP request: measured against cloudflare
    5.4.0 with an `httpx.MockTransport`, `dns.records.list(...)` returns a
    `SyncV4PagePaginationArray`, whose `__iter__` auto-paginates, and `next_page_info()`
    unconditionally returns a next page for any non-empty result -- so `list(page)` always
    fetches one extra, empty page (2 HTTP calls per name, confirmed: `.../dns_records
    ?name.exact=<fqdn>` then `.../dns_records?name.exact=<fqdn>&page=2`). A 218-entry plan
    therefore costs 436 reads in pass 1, not 218.

    Task 5 review, Important 2 (controller ruling): this is the auto-pager's correct behavior --
    it would keep paging if a name ever DID hold more records than fit on one page -- and closing
    the extra fetch would be performance work SPEC section 20 puts out of scope. The real reason
    none of the sibling's read_all/ListTally completeness machinery is ported here is NOT "no
    pagination arises" (it does, every call): a name-filtered query returns a handful of records,
    so a SHORT read here is not the hazard a paginated walk of an 18,848-record zone is (util3
    measured 2 duplicates and 2 misses in one such walk) -- there is no multi-thousand-row
    response for a page to drop a row from.
    """
    try:
        page = client.dns.records.list(zone_id=zone_id, name={"exact": fqdn})
        return list(page)
    except cloudflare.CloudflareError as e:
        raise CloudflareReadError(
            f"cannot list DNS records for {fqdn} in zone {zone_id}: {api_error_text(e)}") from e


def validate_entries(client, entries, *, verbose):
    """Pass 1: classify EVERY selected entry before anything is written (SPEC R3.1).

    Every entry is classified even after the first invalid one: a first-failure-wins loop would
    hide the second problem and cost the operator another full run to find it.

    `delete_ids` is resolved from `governed_records(rows)` directly, NOT by re-filtering rows
    against `want_delete_keys(entry)` (task 5 review, Important 4): when `verdict` is `ready`,
    `verdict_for` has already established `set(keys) == want_delete_keys(entry)` with no
    duplicate keys (duplicates are diverted to `record-ambiguous` before this point), so
    `governed_records(rows)` and `want_delete_keys(entry)` MUST be the same length -- an
    INVARIANT, not a filter.  Checking the invariant here, and raising rather than silently
    resolving a partial id list, is what keeps a future change to either derivation (or to the
    `ready` condition itself) LOUD instead of shipping a partial delete: pass 3 would otherwise
    delete PART of D and POST P, exactly the outcome SPEC section 3 exists to prevent.
    """
    result = {}
    for fqdn, entry in sorted(entries.items()):
        rows = records_at_name(client, entry["zone_id"], fqdn)
        verdict, detail = verdict_for(entry, rows)
        delete_ids = []
        if verdict == "ready":
            delete_ids = [r.id for r in governed_records(rows)]
            expected = len(want_delete_keys(entry))
            if len(delete_ids) != expected:
                raise InvariantError(
                    f"{fqdn}: a `ready` verdict resolved {len(delete_ids)} delete ids for "
                    f"{expected} delete_match records -- verdict_for and validate_entries have "
                    "diverged on what D is")
        if verbose:
            write_report(f"{fqdn}: {verdict}")   # SPEC 11.2: verdict word ONLY, never the
            # detail -- the detail belongs to the unconditional stderr ATTENTION line (Task 7),
            # and printing both would put the same fact on two streams under -v.
        result[fqdn] = Validation(verdict, detail, delete_ids)
    return result


def resolve_env_marker(expr, where):
    """Resolve the body of ONE `<{ ... }` marker.  Only the env forms this script needs.

    Accepts `env NAME [DEFAULT]` and `secret env NAME [DEFAULT]` -- the two forms
    plugin/env/__init__.py registers.  Anything else (`secret aws ...`, `umich ...`) raises,
    rather than passing the literal marker through: a literal "<{secret aws ...}" handed to the
    API as a token would surface as a baffling 401 instead of a config error.

    Tokenizing deliberately uses shlex.split() rather than the config engine's
    list(shlex.shlex(expr, posix=True)), which ALSO splits on punctuation and so turns
    "env FOO some-default" into five tokens; the engine then scores 3 of 5 and reports "no match
    found for configuration file value".  The two agree on every marker the main program can
    actually resolve; this one is marginally more permissive about defaults containing
    punctuation.
    """
    try:
        argv = shlex.split(expr)
    except ValueError as e:
        # shlex raises on an unbalanced quote, e.g. <{env FOO don't}.  Without this the
        # ValueError escapes main() as a raw traceback at exit 1 -- a code SPEC R6 does not use.
        # The body is NOT echoed: the <{env NAME DEFAULT} form can carry a literal credential
        # as its default, and this message reaches stderr and any operator log.
        raise StartupError(f"{where}: malformed substitution ({e})") from e
    # The FORM only (the leading keywords, never an argument): "secret aws", "umich", "env".
    # argv[:2] AFTER the strip below would still carry the secret's path.
    form = " ".join(argv[:2]) or "(empty)"
    if argv[:1] == ["secret"]:
        argv = argv[1:]
    if argv[:1] != ["env"] or not 2 <= len(argv) <= 3:  # noqa: PLR2004 -- NAME, or NAME + DEFAULT
        raise StartupError(
            f"{where}: this script resolves only <{{env NAME}} and <{{secret env NAME}} "
            f"substitutions (each with an optional default), not '{form}'.  Put a literal or "
            "an environment-backed value there.  (The rest of the body is withheld: an inline "
            "default can be a credential.)")
    name = argv[1]
    if name in os.environ:
        return os.environ[name]
    if len(argv) == 3:  # noqa: PLR2004 -- the DEFAULT is present
        return argv[2]
    raise StartupError(f"{where}: environment variable '{name}' is not set")


def resolve_config_value(value, where):
    """Resolve every `<{ ... }` marker inside one config value.  Non-strings pass through."""
    if not isinstance(value, str):
        return value
    return MARKER_RE.sub(lambda match: resolve_env_marker(match.group(1), where), value)


def build_client(**creds):
    """Build a Cloudflare client that uses EXACTLY the credentials the config supplied.

    Measured on cloudflare 5.4.0: the SDK back-fills every credential argument left None from the
    environment.  It reads SIX variables, and ambient values reach the wire by FOUR routes --

      1. `auth_headers` returns the FIRST of email -> key -> token -> user_service_key that is
         set, and only that one -- so an ambient CLOUDFLARE_EMAIL beats a configured token;
      2. `default_headers` separately adds X-Auth-Key / X-Auth-Email whenever those attributes
         are not None;
      3. $CLOUDFLARE_CUSTOM_HEADERS is merged LAST into default_headers, overriding 1 and 2; and
      4. $CLOUDFLARE_BASE_URL redirects every request, sending the configured credential to an
         arbitrary host.

    Routes 1 and 2 are closed by nulling the fields the config did not supply (both read these
    attributes at request-build time); route 3 by clearing _custom_headers; route 4 by pinning
    base_url.  Routes 3 and 4 were missed on the first pass -- and 4 is worse than the defect
    this function was written for, because the credential LEAVES THE MACHINE rather than merely
    failing to authenticate.  This pin is SDK-version-sensitive: measured against cloudflare
    5.4.0, and pyproject declares the dependency unpinned as "cloudflare".

    The main program carries the SAME pin, by the same mechanism, in
    plugin/cloudflare/client.py's pinned_client() (added 2026-07-30, commit befb913).
    find-platform-domains-cloudflare carries a second, independent copy for the same reason (it
    imports nothing from plugin/, so it stays `git rm`-deletable). This is a deliberate THIRD
    COPY, not a fork: this utility also imports nothing from plugin/ or find-platform-domains-
    cloudflare, so deleting it stays `git rm` of this file and its .py symlink.  An SDK upgrade
    must re-verify ALL THREE -- each has its own test asserting a REAL built request rather than
    these attribute assignments, so a change that breaks any one goes red rather than silently
    reopening the route.

    THIS copy is the only one of the three that performs WRITES.  That raises route 4
    ($CLOUDFLARE_BASE_URL) from "the credential leaves the machine" to "the credential leaves the
    machine AND a destructive rewrite is aimed at whatever host answers".  The pin is therefore
    load-bearing here in a way it is not in the two read-only siblings.
    """
    try:
        client = Cloudflare(**creds, base_url=API_BASE_URL)
    except OSError as e:
        # httpx builds its SSL context from the ambient environment (trust_env=True), so an
        # $SSL_CERT_FILE pointing at a missing path raises here -- another unnamed escape to
        # exit 1 if left alone (SPEC section R2a, residual routes).
        raise StartupError(f"could not build the Cloudflare client: {e}") from e
    for field in ("api_token", "api_key", "api_email", "user_service_key"):
        if field not in creds:
            setattr(client, field, None)
    client._custom_headers = {}  # noqa: SLF001 -- $CLOUDFLARE_CUSTOM_HEADERS is merged LAST
    # into default_headers, so it overrides the pinned Omit()s above; there is no public API
    # for "ignore that variable".  Measured: without this line and the base_url pin above,
    # exporting CLOUDFLARE_BASE_URL pointed at an attacker host, together with a
    # CLOUDFLARE_CUSTOM_HEADERS value supplying X-Auth-Email and X-Auth-Key, sends
    # `Authorization: Bearer <the real token>` to that host -- the pinned credential leaves the
    # machine.  That is strictly worse than the defect the field pinning above fixes.
    return client


def cloudflare_client(config_path):
    """Build the Cloudflare client from the [Cloudflare] table of the TOML at `config_path`.

    api_token wins when present; otherwise email + api_key, both required -- the same precedence
    plugin/cloudflare/client.py uses.  `enabled` is deliberately NOT consulted: that flag governs
    the main program's per-site Cloudflare work, and refusing to run this utility because of it
    would be a surprise to an operator who invoked it on purpose.
    """
    try:
        with Path(config_path).open("rb") as handle:
            config = tomllib.load(handle)
    except OSError as e:
        raise StartupError(f"cannot read {config_path}: {e}") from e
    except ValueError as e:
        # ValueError, not TOMLDecodeError: tomllib.load decodes the bytes itself, so a config
        # file that is not valid UTF-8 raises UnicodeDecodeError -- which is NOT a
        # TOMLDecodeError, and escaped as a raw traceback at exit 1 (a code SPEC R6 does not
        # use).  Both are ValueError subclasses, so one clause closes the class rather than the
        # instance -- the third time this defect class appeared (SPEC section 13).
        raise StartupError(f"{config_path} is not valid TOML: {e}") from e

    section = config.get("Cloudflare")
    if not isinstance(section, dict):
        raise StartupError(f"{config_path} has no [Cloudflare] section")

    def value(key):
        """One credential, type-checked where it is read then marker-resolved.

        TOML is a typed format, so `api_token = true` (an unquoted value -- an ordinary typo) is
        a bool, which `if api_token:` accepts and the SDK stringifies into
        `Authorization: Bearer True` -- exactly the confusing 401 that resolve_env_marker refuses
        to cause for an unresolvable marker.  The check belongs here, where the value is read.
        """
        raw = section.get(key)
        where = f"{config_path} [Cloudflare].{key}"
        if raw is not None and not isinstance(raw, str):
            raise StartupError(f"{where} must be a string, got {type(raw).__name__}")
        return resolve_config_value(raw, where)

    api_token = value("api_token")
    if api_token:
        return build_client(api_token=api_token)
    email = value("email")
    api_key = value("api_key")
    if not email or not api_key:
        raise StartupError(
            f"{config_path} [Cloudflare] needs either api_token, or both email and api_key")
    return build_client(api_email=email, api_key=api_key)


def api_error_text(e):
    """A message for a Cloudflare API failure (SPEC 9.1).

    Adapted from find-platform-domains-cloudflare's function of the same name, which NEVER admits
    a response body.  Its docstring gives two reasons: "a DNS-record body echoes record contents
    and an auth-failure body can echo the credential."  The first does not apply here -- this
    script's operator already holds the file describing those exact records, and a failed WRITE is
    undiagnosable without Cloudflare's own reason for it.  The second is real, and rule 2 below is
    what keeps it closed.

    Three rules, exhaustive:
      1. Only the structured errors[].code and errors[].message.  NEVER str(e), never the raw
         body, never headers, never error_chain or any other nested member -- including on the
         no-status-code fallback path, which has nothing else to report but must not fall back to
         str(e): a status_code-less exception (e.g. a connection failure) can still carry
         credential material in its own message (review round 1, finding 2).
      2. NOTHING but the class and the status on HTTP 401/403 -- exactly the response class the
         sibling's warning is about.  An auth failure needs no per-record diagnosis anyway: the
         run is misconfigured, not drifted.
      3. Each message truncated to ERROR_MESSAGE_LIMIT characters and each code to
         MAX_CODE_LENGTH, AND at most MAX_ADMITTED_ERRORS entries admitted at all -- the total
         error count is still reported, with the remainder named as "… and N more".  Per-message
         truncation alone bounds each entry but not an array's LENGTH: a 5000-entry array produced
         a message over 1,000,000 characters before this cap existed (review round 1, finding 3).
    """
    status = getattr(e, "status_code", None)
    if status is None:
        return f"{type(e).__name__}: (no HTTP status; the response is withheld)"
    if status in (401, 403):
        return (f"{type(e).__name__}: HTTP {status} (authentication or authorization failed; "
                "the response is withheld because it can echo the credential)")
    body = getattr(e, "body", None)
    errors = body.get("errors") if isinstance(body, dict) else None
    if not isinstance(errors, list) or not errors:
        return f"{type(e).__name__}: HTTP {status}"
    admitted = errors[:MAX_ADMITTED_ERRORS]
    parts = []
    for item in admitted:
        if not isinstance(item, dict):
            continue
        code = str(item.get("code", ""))[:MAX_CODE_LENGTH]
        message = str(item.get("message", ""))[:ERROR_MESSAGE_LIMIT]
        parts.append(f"{code} {message}".strip())
    if not parts:
        return f"{type(e).__name__}: HTTP {status}"
    remaining = len(errors) - len(admitted)
    suffix = f"; … and {remaining} more" if remaining else ""
    return (f"{type(e).__name__}: HTTP {status} ({len(errors)} error(s)): "
            + "; ".join(parts) + suffix)


OUTCOMES = ("applied", "already-applied", "planned", "failed", "unverified", "unknown",
           "not-attempted")


def tally(outcomes):
    """Count outcomes, zero-filling every key so no consumer has to .get() (SPEC 12.2).

    `outcomes` maps fqdn -> one of OUTCOMES; only the values matter.  An outcome string outside
    OUTCOMES is a defect upstream (a typo'd literal, not operator input), so it raises
    InvariantError rather than silently landing nowhere -- the same discipline verdict_for and
    validate_entries already apply to their own closed vocabularies.
    """
    counts = dict.fromkeys(OUTCOMES, 0)
    for outcome in outcomes.values():
        if outcome not in counts:
            raise InvariantError(f"unknown outcome {outcome!r}")
        counts[outcome] += 1
    return counts


def changed_count(counts):
    """SPEC 8.1's `changed`: entries whose outcome is `applied`, `unverified` OR `unknown` --
    every state in which Cloudflare MAY or DOES hold a change (the four-state table's first three
    rows; `failed` is the one state in which nothing committed for that entry, since a batch is
    one transaction).

    Extracted so `exit_code_for` and `summary_lines` cannot independently drift on this one,
    most-consequential formula (Task 8 review, Important 3): before this, both had their OWN
    correct copy of the same three-term sum -- each independently mutation-tested, which caught a
    change to either copy but not the two silently diverging from each other.
    """
    return counts["applied"] + counts["unverified"] + counts["unknown"]


def exit_code_for(counts):
    """SPEC section 8, as a PURE function of the tally.

    Extracted deliberately: it is the most consequential logic in this script and would otherwise
    be reachable only through a full end-to-end run.  It covers the dry-run and post-apply paths;
    a validation failure returns 2 and an interrupt returns 130 directly from main(), before any
    outcome exists.

    The run "did not cleanly succeed" whenever ANY entry is `failed`, `unverified` or `unknown` --
    all three are states pass 3 stops the run on (SPEC R3.4).  Once that is true, `changed_count`
    (SPEC 8.1) decides 2 vs 3: an entry whose batch call was rejected outright commits nothing, but
    an `unverified` or `unknown` entry means Cloudflare MAY or DOES hold a change we cannot fully
    account for, and reporting "nothing was changed" about that is exactly the silent failure PD#1
    forbids.  `unverified` must ALSO be in the trigger condition, not just in `changed_count`: an
    all-`unverified` run (no `failed`, no `unknown`) would otherwise fall through to `return 0`,
    the code that means "every selected entry applied... AND read back as expected" -- false for
    exactly the entries this outcome exists to flag.
    """
    if counts["failed"] or counts["unverified"] or counts["unknown"]:
        return 3 if changed_count(counts) else 2
    if counts["already-applied"]:
        return 1
    return 0


def summary_lines(*, direction, source, source_generated_at, for_real, entries_in_file,  # noqa: PLR0913 -- the exact keyword-only interface SPEC 11.3/R8.1 requires for the block printed on every exit path; splitting it would just move the same 8 facts into a second data structure
                  selected, counts, record_path):
    """The block printed on EVERY exit path (SPEC R8.1, 11.3).

    Iterates OUTCOMES rather than a hardcoded name list, so a future addition to that tuple
    cannot silently vanish from the operator's only report -- the same reasoning as tally's
    zero-fill.

    The `mode:` line is derived from the TALLY, never from `for_real` alone (SPEC 11.3, amended
    by the task 7 review, important 2): "FOR REAL -- changes were made" is a claim about
    production DNS, and a for-real run that reached no entry -- every one already-applied, or an
    abort in validation -- would assert a rewrite that never happened.  `changed_count` is SPEC
    8.1's own definition (applied + unverified + unknown, the SAME shared helper `exit_code_for`
    uses -- Task 8 review, important 3), so this stays true on every path: a clean --for-real run
    reads "N of N entries changed", and a --for-real run that reached no entry (every one
    already-applied, or an abort in validation) reads "0 of N entries changed".
    """
    if for_real:
        mode = f"FOR REAL -- {changed_count(counts)} of {selected} entries changed"
    else:
        mode = "DRY RUN -- no changes were made"
    return [
        f"apply-platform-domains-cloudflare: direction={direction}",
        f"  source: {source} (generated {source_generated_at})",
        f"  mode:   {mode}",
        f"  entries in file: {entries_in_file}   selected: {selected}   "
        "(entries are FQDNs, not Pantheon sites)",
        "  " + "   ".join(f"{name.replace('-', ' ')} {counts[name]}" for name in OUTCOMES),
        f"  record: {record_path}",
    ]


def merge_body(entry, delete_ids):
    """The postable batch body (SPEC R5.1).

    `posts` is the file's own list, passed through UNMODIFIED -- the whole value of the plan file
    is that its body is "the exact JSON body to be used for the API call".  A shallow copy of the
    envelope keeps this from mutating the entry, which is written to the run record afterwards.

    Cloudflare executes Deletes before Posts inside one database transaction, which is what lets
    a CNAME and its replacement A records -- which cannot coexist -- be swapped in one step.

    Raises InvariantError (SPEC 9.1) on either of two malformed-input shapes, so both fail LOUD
    and NAMED rather than as an anonymous KeyError or a silent partial write (task 7 review,
    important 4 -- the same nil-shadow class verdict_for already guards, re-opened here in two
    fresh instances; "fix the class, not the instance"):
      - an entry whose body.posts is missing or empty -- section 6 check 7 should already have
        made this fatal before pass 1 ever ran;
      - a call with no delete ids at all.  Only a `ready` verdict's resolved ids may reach this
        function; posting the new records while deleting NOTHING would leave the old record
        standing beside them, exactly the partial write section 3 exists to prevent.
    """
    posts = entry.get("body", {}).get("posts")
    if not posts:
        raise InvariantError(
            "merge_body: entry has an empty or missing body.posts -- section 6 check 7 should "
            "have made this fatal before pass 1 ever ran")
    if not delete_ids:
        raise InvariantError(
            "merge_body: called with no delete ids -- posting these records while deleting "
            "nothing would leave the old record standing beside them, the partial write section "
            "3 exists to prevent")
    return {"deletes": [{"id": identifier} for identifier in delete_ids], "posts": posts}


def verify_records(entry, rows):
    """True when Cloudflare now holds exactly this entry's posts (SPEC R6.1).

    Compared as `record_key()` SETS over the governed types only, the same rule pass 1's
    `verdict_for` uses for R == P -- so a TXT/MX/CAA record at the name (never touched by this
    script) cannot make a healthy apply look unverified.

    Raises InvariantError (SPEC 9.1) on an empty/missing `body.posts` -- the FOURTH instance of
    the nil-shadow class this file already guards against in `verdict_for`, `merge_body` and
    `describe_change` (Task 8 review, minor 7; "fix the class, not the instance").  Without this
    guard, `verify_records(entry-with-empty-posts, [])` returned True: two EMPTY sets compare
    equal, reporting a successful verification for a call that verified nothing, and a missing
    `body` raised a bare, unnamed KeyError.  Unreachable through `apply_entry` today (`merge_body`
    already guards the same shape first), but this is a section-13-listed public helper in its own
    right.
    """
    posts = entry.get("body", {}).get("posts")
    if not posts:
        raise InvariantError(
            "verify_records: entry has an empty or missing body.posts -- section 6 check 7 "
            "should have made this fatal before pass 1 ever ran")
    have = {record_key(r.type, r.name, r.content) for r in governed_records(rows)}
    want = {record_key(item["type"], item["name"], item["content"]) for item in posts}
    return have == want


def apply_entry(client, fqdn, entry, delete_ids):
    """One batch call, then the evidence (SPEC R5, R6).  Returns the created record ids.

    A 200 from the batch endpoint is Cloudflare's CLAIM that the swap happened; the record list
    is the EVIDENCE (PD#14).  The single retry exists because Cloudflare's own batch documentation
    warns that "the propagation of changes is not atomic", so a read served before the change
    lands would be a false mismatch on a healthy run (SPEC R6.2).

    The typed client.dns.records.batch() is used rather than a raw POST of the file's body:
    measured on cloudflare 5.4.0, its maybe_transform returns the body byte-identical (including a
    key its schema does not define), so the file's exact body survives it, and check_file_contract
    has already asserted that the file's method and path are the ones this call produces (SPEC
    R5.3).

    Exception ordering is load-bearing (SPEC 9.1, 8.1).  Measured against cloudflare 5.4.0:
    `cloudflare.APIConnectionError` (and `APITimeoutError`, one of its subclasses) IS a
    `cloudflare.CloudflareError` -- so the APIConnectionError clause MUST come first and MUST
    bare-`raise` rather than wrap into ApplyError.  A dropped connection did not tell us whether
    Cloudflare committed the write; recording it as an ordinary `failed` ApplyError would make
    `exit_code_for` treat a rewrite of unknown fate as "nothing was changed" -- the exact silent
    failure PD#1 forbids.  apply_all is the layer that turns the bare re-raise into the `unknown`
    outcome; this function only distinguishes the two, it does not decide the outcome.

    The batch-call clause and the two verification clauses below raise DIFFERENT exception
    classes for the same reason (SPEC R6.3, 8.1's four-state table, added after Task 8's review
    surfaced the contradiction in the original three-outcome design): a REJECTED batch call
    (`ApplyError`) commits nothing, so this entry is untouched; a batch call that RETURNED but did
    not verify (`VerifyError`, a subclass) means Cloudflare committed SOMETHING -- only our
    confirmation of it is in doubt.  Collapsing the two into one exception class would leave
    `apply_all` unable to tell "nothing happened" from "something happened, go look" apart.
    """
    body = merge_body(entry, delete_ids)
    try:
        client.dns.records.batch(zone_id=entry["zone_id"],
                                 deletes=body["deletes"], posts=body["posts"])
    except cloudflare.APIConnectionError:
        raise   # unknown fate -- apply_all records `unknown`, never wraps this into ApplyError
    except cloudflare.CloudflareError as e:
        raise ApplyError(f"{fqdn}: batch call rejected: {api_error_text(e)}") from e

    for attempt in (1, 2):
        try:
            rows = list(client.dns.records.list(zone_id=entry["zone_id"],
                                                name={"exact": fqdn}))
        except cloudflare.CloudflareError as e:
            # The batch call above already succeeded -- Cloudflare committed SOMETHING -- so this
            # is deliberately a VerifyError (SPEC R6.3's second trigger: the verification READ
            # itself failed), never re-raised bare like the batch clause above: only the batch
            # call itself can leave Cloudflare's own COMMIT in doubt, and this one already
            # happened.
            raise VerifyError(
                f"{fqdn}: the batch call succeeded but the verification read failed, so the "
                f"result is unconfirmed: {api_error_text(e)}") from e
        if verify_records(entry, rows):
            return [r.id for r in governed_records(rows)]
        if attempt == 1:
            sleep(VERIFY_RETRY_SLEEP)
    held = describe_keys(sorted({record_key(r.type, r.name, r.content)
                                 for r in governed_records(rows)})) or "no CNAME/A/AAAA record"
    raise VerifyError(
        f"{fqdn}: the batch call succeeded but Cloudflare does not hold the expected records "
        f"afterwards, twice {VERIFY_RETRY_SLEEP}s apart; it now holds {held}")


def apply_all(client, entries, validations, outcomes, details):
    """Pass 3 (SPEC R3.4): in key order, one entry at a time, stopping at the first failure.

    Nothing already applied is reverted and nothing further is attempted -- PROMPT.md is explicit
    on both ("it should not attempt to revert any changes it has already made, and it should not
    attempt to make the remaining changes specified in the file").  Every unattempted entry keeps
    its `not-attempted` seed value from before this loop starts.

    `outcomes`/`details` are CALLER-OWNED mutable dicts (mutated in place, not built fresh here),
    a contract change from Task 8's original shape (Task 8 review, minor 11): returning them BY
    VALUE meant a `KeyboardInterrupt` raised out of `apply_entry` discarded every outcome
    accumulated so far, because the exception unwinds straight past the `return` -- and SPEC 9.3
    requires the in-flight entry `unknown` and the rest `not-attempted` to survive that, which is
    only possible if the caller already holds the SAME dict objects this function mutates.  The
    caller still constructs them as `dict.fromkeys(entries, "not-attempted")` / `{}`, exactly what
    this function built internally before; only who OWNS the object changed.  The `except
    KeyboardInterrupt` arm below is the other half: it marks the in-flight entry before re-raising,
    so a Ctrl-C mid-batch-call or mid-verification-retry is never silently lost.  This function
    returns NOTHING (Task 8 re-review, minor 8): every caller already holds `outcomes`/`details` by
    reference, so a `return outcomes, details` alongside "mutated in place" was a second,
    unnecessary way to read the same state, and `main()` never used the value it stood for.

    Dropped the `verbose` keyword this function took at Task 8's first pass: SPEC 11.2's message
    table has no pass-3-only `-v` line -- the `POST <path>` + exact body row belongs entirely to
    pass 2 (`report_entries`, which already ran, under the same `-v`, for every entry reaching
    this function) -- so a second copy printed here was a plain duplicate under `-v --for-real`
    (Task 8 review, minor 9), and the parameter had no other use once it was removed.

    Three outcomes -- `unverified`, `failed`, `unknown` -- each stop the run immediately and are
    mutually exclusive per entry (SPEC 8.1's four-state table, added after Task 8's review
    surfaced a contradiction in the original three-outcome design):
      - `unverified` (`VerifyError`): the batch call RETURNED (Cloudflare committed something) but
        the post-apply read never confirmed it -- inspect this FQDN by hand.
      - `failed` (`ApplyError`, and NOT its `VerifyError` subclass -- caught below it): the batch
        call was REJECTED, so nothing committed for this entry.
      - `unknown` (`cloudflare.APIConnectionError`/`TimeoutError`/`OSError`): the call did not
        complete at all, so whether it committed is not known.  `TimeoutError`/`OSError` are
        caught alongside `APIConnectionError` for PD#3's upstream-error shadow: a transport-level
        failure the SDK's own retry loop did not manage to wrap can reach here as a raw stdlib
        exception rather than the SDK's own class.
    Recording any of the three as `failed` (or vice versa) would make `exit_code_for` report the
    wrong thing happened to production DNS -- the exact silent failure PD#1 forbids.

    Per entry's result line, the failure reason is written to BOTH streams (SPEC 11.2, ruling
    `f6639ad`): stdout as part of the `<fqdn>  <OUTCOME> -- <reason>` result line (so `> apply.log`
    captures a full account of what broke, not just that something did), and stderr as the
    `ERROR:` line (so an operator watching the terminal is not left to scroll a long report to
    find out).  This is the one deliberate duplication in SPEC 11.2's message table.

    Every stdout line goes through `write_report`, never a bare `print` (SPEC 11.1) -- the same
    discipline `report_entries` already applies.  Pass 3 does NOT print its own `POST <path>`
    line: SPEC 11.2's `-v` POST-body row is pass 2's (`report_entries`, which already ran for
    every one of these entries before pass 3 starts), and a second, bare `POST <path>` line here
    was a plain duplicate under `-v --for-real` (Task 8 review, minor 9).

    Every `details[fqdn]` assignment below also carries `"at": now_utc()` (Task 9, SPEC 12.2/12.3)
    -- the moment THIS entry's outcome was decided, not the run's overall `run.at` finish() stamps
    once at the end.  `already-applied` (the `continue` above) gets none: that verdict is decided
    in pass 1, not by this function, and SPEC 12.2's own example shows no `at` for `not-attempted`
    either -- only for entries THIS function actually recorded an outcome for.
    """
    for fqdn, entry in sorted(entries.items()):
        validation = validations[fqdn]
        if validation.verdict == "already-applied":
            outcomes[fqdn] = "already-applied"
            continue
        if validation.verdict != "ready":
            raise InvariantError(
                f"{fqdn} reached the apply pass with verdict {validation.verdict!r}; pass 1 "
                "should have aborted the run")
        try:
            created = apply_entry(client, fqdn, entry, validation.delete_ids)
        except KeyboardInterrupt:
            # SPEC 9.3: the in-flight entry's fate is UNKNOWN, never `failed`/`not-attempted` --
            # whichever stage inside apply_entry was interrupted (the batch call itself, the
            # verification read, or the retry sleep), we cannot tell whether Cloudflare committed.
            outcomes[fqdn] = "unknown"
            details[fqdn] = {"error": "interrupted", "deleted_ids": validation.delete_ids,
                             "at": now_utc()}
            raise
        except (cloudflare.APIConnectionError, TimeoutError, OSError) as e:
            # Listed BEFORE ApplyError/VerifyError: an unknown-fate transport failure must never
            # be caught by either of the broader clauses below and recorded as `failed`/
            # `unverified`.
            reason = f"the call did not complete ({type(e).__name__}: {e})"
            outcomes[fqdn] = "unknown"
            details[fqdn] = {"error": reason, "deleted_ids": validation.delete_ids,
                             "at": now_utc()}
            write_report(f"{fqdn}  UNKNOWN -- {reason}")
            report_line(
                f"ERROR: {fqdn}: {reason}, so whether Cloudflare applied it is UNKNOWN.  Check "
                "this FQDN by hand before re-running.")
            return
        except VerifyError as e:
            # Listed BEFORE the plain ApplyError clause: VerifyError IS an ApplyError (SPEC 8.1),
            # and the broader clause below would otherwise catch it first and record `failed`,
            # collapsing "committed but unconfirmed" into "nothing committed".  `reason` strips the
            # `apply_entry`-added "<fqdn>: " prefix for the stdout result line and the run-record
            # detail (Task 8 re-review, minor 6: without this, the result line read the FQDN
            # twice -- once as the line's own leading column, once again inside `str(e)`); stderr
            # keeps the FULL `str(e)`, fqdn prefix included, since it is not printed beside a
            # per-entry column.
            reason = str(e).removeprefix(f"{fqdn}: ")
            outcomes[fqdn] = "unverified"
            details[fqdn] = {"error": reason, "deleted_ids": validation.delete_ids,
                             "at": now_utc()}
            write_report(f"{fqdn}  UNVERIFIED -- {reason}")
            report_line(f"ERROR: {e}")
            return
        except ApplyError as e:
            reason = str(e).removeprefix(f"{fqdn}: ")  # see the VerifyError arm above
            outcomes[fqdn] = "failed"
            details[fqdn] = {"error": reason, "deleted_ids": validation.delete_ids,
                             "at": now_utc()}
            write_report(f"{fqdn}  FAILED -- {reason}")
            report_line(f"ERROR: {e}")
            return
        outcomes[fqdn] = "applied"
        details[fqdn] = {"deleted_ids": validation.delete_ids, "created_ids": created,
                         "at": now_utc()}
        write_report(f"{fqdn}  applied")


def render_records(items):
    """SPEC 11.4's grouping rule: same-TYPE contents joined with ', ', different types joined
    with ' + ' -- e.g. "A 23.185.0.4, 23.185.0.5 + AAAA 2620:12a:8000::4".  Task 7 review, minor
    9: the original code used ", ".join throughout, which cannot express the distinction (two A
    records would render indistinguishably from one A and one AAAA).  Groups in first-seen order
    (dict preserves insertion order), matching the file's own posts/delete_match ordering.
    """
    groups = {}
    for item in items:
        groups.setdefault(item["type"], []).append(item["content"])
    return " + ".join(f"{rtype} {', '.join(contents)}" for rtype, contents in groups.items())


def describe_change(fqdn, entry):
    """One human line for one entry (SPEC 11.4), derived ENTIRELY from the entry.

    It shows the zone ID rather than a zone name because a plan/revert entry carries zone_id and
    nothing else about the zone (zone_name lives only in the inventory, which this script never
    reads).  Looking a name up would be a second Cloudflare read per entry, for cosmetics.

    Raises InvariantError (SPEC 9.1) on the same nil shadow verdict_for's guard already names --
    an empty/missing delete_match or body.posts, which section 6 checks 7/8 should already have
    made fatal before pass 1 ever ran.  Task 7 review, important 4: measured before this guard
    existed, describe_change(empty posts) raised a bare, unnamed `IndexError` from `posts[0]`.
    """
    deletes = entry.get("delete_match")
    posts = entry.get("body", {}).get("posts")
    if not deletes or not posts:
        raise InvariantError(
            "describe_change: entry has an empty or missing delete_match/body.posts -- section "
            "6 checks 7 and 8 should have made this fatal before pass 1 ever ran")
    first = posts[0]
    flags = "proxied" if first.get("proxied") else "DNS-only"
    return (f"{fqdn}  zone {entry['zone_id']}  {render_records(deletes)} -> "
            f"{render_records(posts)}  ({flags}, ttl {first.get('ttl')})")


def report_entries(entries, validations, *, verbose) -> None:
    """Pass 2 (SPEC R3.3): identical in both modes, from the data pass 1 produced."""
    for fqdn, entry in sorted(entries.items()):
        validation = validations[fqdn]
        if validation.verdict == "already-applied":
            write_report(f"{fqdn}  already applied -- nothing to do")
            continue
        write_report(describe_change(fqdn, entry))
        if verbose:
            body = merge_body(entry, validation.delete_ids)
            write_report(f"    POST {entry['path']}")
            write_report("    " + json.dumps(body, indent=4, sort_keys=True).replace(
                "\n", "\n    "))


def outcome_path(input_path, at):
    """<input-stem>-run-<YYYYMMDDThhmmssZ>.json, beside the input file (SPEC 12.1).

    Named `-run-`, not `-applied-`, because a DRY RUN writes one too -- with for_real false and
    every ready entry recorded as `planned`, which makes it the validation report an operator can
    attach to a change ticket before the change ever happens.  The timestamp comes from the
    now_utc() seam (SPEC 12.1/12.3) and makes a run incapable of clobbering a previous one.

    The repository's existing .gitignore line /platform-domains-cloudflare*.json already covers
    records written beside the conventional baseline, so no new ignore entry is needed (SPEC 19).
    """
    stamp = at.replace("-", "").replace(":", "")
    source = Path(input_path)
    return str(source.with_name(f"{source.stem}-run-{stamp}.json"))


def outcome_document(*, at, direction, source, source_generated_at, for_real, argv, exit_code,  # noqa: PLR0913 -- every argument is a distinct SPEC 12.2 run-record field; bundling them into a second data structure just to shrink this list would not reduce what finish() passes, the same reasoning summary_lines' own noqa above gives
                     entries_in_file, selected, counts, outcomes, details, validations):
    """The SPEC 12.2 run-record document.

    Iterates `sorted(outcomes)` -- the CALLER-OWNED dict main() seeds with `not-attempted` for
    every SELECTED entry the moment selection succeeds (SPEC R9.1, task 9 requirement 1) -- so
    `entries` always has one object per selected entry, whatever the run's outcome, never only the
    entries pass 3 happened to reach.

    A verdict/detail pair is added only for the invalid verdicts (SPEC 7.3's four INVALID rows):
    `ready` and `already-applied` are the two VALID verdicts, and repeating either of them here
    would just restate the `outcome` key one line down for every healthy entry in the file --
    `validations` still holds one Validation per SELECTED entry regardless (a dict `main()`
    populates right after validate_entries returns), so `.get(fqdn)` is `None` only when
    validate_entries itself never ran for this entry (a --only-narrowed entry, or a read failure
    that stopped validate_entries before reaching this one).

    `details.get(fqdn, {})` supplies everything apply_all/apply_entry know about a pass-3-touched
    entry -- `deleted_ids`/`created_ids` on success, `error` (and `deleted_ids`) on
    failed/unverified/unknown/interrupted, each carrying its OWN `at` (apply_all stamps one at the
    moment it records the outcome, SPEC 12.3) -- `.update()` rather than a fresh dict so a future
    detail key needs no change here.
    """
    entries = {}
    for fqdn in sorted(outcomes):
        item = {"outcome": outcomes[fqdn]}
        validation = validations.get(fqdn)
        if validation is not None and validation.verdict not in ("ready", "already-applied"):
            item["verdict"] = validation.verdict
            item["detail"] = validation.detail
        item.update(details.get(fqdn, {}))
        entries[fqdn] = item
    return {
        "run": {"at": at, "tool": "apply-platform-domains-cloudflare", "direction": direction,
                "source": source, "source_generated_at": source_generated_at,
                "for_real": for_real, "argv": list(argv), "exit_code": exit_code,
                "entries_in_file": entries_in_file, "selected": selected, "counts": counts},
        "entries": entries,
    }


def write_run_record(path, document) -> None:
    """Write the run record atomically (SPEC R9.1), through the SAME write_json_atomic() the
    sibling scripts use -- temp file + os.replace(), so an interrupted write never leaves a
    half-written record where a previous run's still stands.

    Named OutputWriteError rather than reusing OSError because the failure is not always an
    OS-level one: dump_json()'s json.dump() call raises TypeError/ValueError on an unserializable
    value, and calling THAT an OSError would be exactly the "handle errors" mis-naming PD#2
    forbids.  A StartupError subclass (SPEC 9.1) so it flows through main()'s existing exception
    spine -- this adds a NAME, not a new code path -- but its exit code is decided by finish()'s
    OWN SPEC 9.2 precedence rule, not by the generic StartupError handler: unlike every other
    StartupError, a run RECORD write failure can follow a run that already changed something.
    """
    try:
        write_json_atomic(path, document)
    except (OSError, TypeError, ValueError) as e:
        raise OutputWriteError(
            f"cannot write the run record {path}: {type(e).__name__}: {e}") from e


def build_arg_parser():
    """The CLI (SPEC R2).

    --only is action="append", NOT nargs="+", and that is load-bearing: with one positional FILE,
    `--only a b file.json` under nargs="+" would silently swallow the filename into the option.
    The sibling documents the same argparse limitation in its own --help ("Give ZONE names AFTER
    the options").  A repeatable single-value option has no such ambiguity.

    allow_abbrev=False is the house rule: without it `--for` abbreviates to `--for-real` and a
    dry run becomes a production rewrite.

    formatter_class pins the wrap width to 100: argparse's default formatter wraps at
    shutil.get_terminal_size(), so WITHOUT a pin the --for-real warning below ("WITHOUT THIS FLAG
    NOTHING IS CHANGED") lands mid-phrase across two lines on an 80-column terminal -- the
    default for any non-tty invocation (cron, a redirect, this test suite).  A safety warning
    that can be silently split by the caller's terminal width is a real defect (PD#1), not just a
    test nicety, so --help output is deterministic instead of ambient-width-dependent.
    """
    parser = argparse.ArgumentParser(
        allow_abbrev=False,
        formatter_class=lambda prog: argparse.HelpFormatter(prog, width=100),
        description="Apply a plan or revert file produced by find-platform-domains-cloudflare.  "
                    "Validates every selected entry against live Cloudflare state first and "
                    "refuses to change anything if any entry fails.  WITHOUT --for-real this is "
                    "a dry run: it reports what it would do and changes nothing.",
        epilog="Exit codes: 0 = everything applied (or a dry run that validated clean), "
               "1 = completed with already-applied entries skipped, 2 = could not complete and "
               "NOTHING was changed, 3 = FAILED MID-APPLY and Cloudflare was left partially "
               "changed, 130 = interrupted.  A run record naming every entry's outcome is "
               "written beside FILE on every one of those paths.")
    parser.add_argument("file", metavar="FILE",
                        help="the -plan.json or -revert.json file to apply")
    parser.add_argument("-c", "--config", default=DEFAULT_CONFIG,
                        help=f"TOML file to read [Cloudflare] credentials from "
                             f"(default: {DEFAULT_CONFIG})")
    parser.add_argument("--only", action="append", default=None, metavar="FQDN",
                        help="apply only this FQDN; repeat the option for more than one.  An "
                             "FQDN that is not in FILE is an error")
    parser.add_argument("--for-real", action="store_true",
                        help="actually make the Cloudflare API calls.  WITHOUT THIS FLAG NOTHING "
                             "IS CHANGED")
    parser.add_argument("-v", "--verbose", action="store_true",
                        help="also print each API call's method, path and exact request body")
    return parser


def abort_on_invalid_entries(validations) -> bool:
    """SPEC R3.2/11.2: name every invalid entry and report the abort -- returns True when main()
    must stop at exit 2 having changed nothing.

    NARROWED by Task 9 to just the ATTENTION lines and the abort ERROR line: through Task 7/8 this
    function also printed its OWN copy of the summary block, which is now finish()'s job, printed
    on EVERY exit path from exactly ONE place (SPEC R8.1/R9.1) -- if this function kept printing
    its own copy too, a validation failure would print the summary TWICE.  SPEC 11.2's own message
    table orders these ATTENTION/ERROR lines BEFORE the summary block, which is exactly the split
    that falls out of this: abort_on_invalid_entries owns everything the table lists before the
    summary row, finish() owns the summary row and everything after it.

    `len(validations)` stands in for "entries selected" (task 7's `len(entries)`, since removed
    from this function's signature): validate_entries() returns exactly one Validation per entry
    it was CALLED with, so the two were always the same number.
    """
    invalid = {fqdn: v for fqdn, v in validations.items()
               if v.verdict not in ("ready", "already-applied")}
    for fqdn, validation in sorted(invalid.items()):
        # NEVER -v-gated (SPEC R7.3): the only signal that a destructive run was refused.
        print(f"ATTENTION: {fqdn} {validation.verdict}: {validation.detail}",
              file=sys.stderr, flush=True)
    if not invalid:
        return False
    report_line(
        f"ERROR: {len(invalid)} of {len(validations)} selected entries did not match "
        "Cloudflare's current state; NOTHING was changed.  Re-generate the baseline "
        "with find-platform-domains-cloudflare and try again.")
    return True


def finish(code, *, options, argv, state):
    """Print the summary block and write the run record -- SPEC R8.1/R9.1, on EVERY exit path.
    Returns the exit code main() should actually use, which is `code` unchanged unless the run
    record write itself fails (SPEC 9.2's precedence rule, below).

    Module-level, not a closure inside main(): nested function DEFINITIONS count toward the
    ENCLOSING function's own ruff C901/PLR0915 totals (measured directly -- nesting this and
    run_once() inside main() pushed main() from 13 to 14 branches and 53 statements, both over
    the gate), so `options`/`argv`/`state` are passed explicitly instead of closed over.

    SIGINT -> SIG_IGN FIRST, mirroring psh/lifecycle.py's `abort_run()` and the DNS sibling's
    `report_stop()` (CLAUDE.md's Database section: "a second Ctrl-C landing mid-flush must not
    truncate the only record of what a destructive run did").  Called bare, matching both of those
    precedents -- neither wraps it in a `ValueError` guard, and this script has no thread that
    would raise "signal only works in main thread" either.

    The summary print is wrapped in its OWN `try`/`except StartupError`.  This matters because
    finish() is called from several places in main(), MOST of them already inside one of its
    `except` clauses -- and a fresh exception raised INSIDE an except clause is never redispatched
    to a sibling except of the SAME try statement.  Without this local catch, a doomed stdout hit
    for the FIRST time here (a run that fails before a single byte of report exists at all -- e.g.
    a missing FILE argument) would escape main() entirely as an unhandled StartupError, instead of
    the named, bounded exit every OTHER doomed-stdout path in this script produces -- the fourth
    instance of the "a doomed stream overrides the exit code" bug class this script family keeps
    finding (CLAUDE.md records the first three).  write_report() has already detached the doomed
    stream and named the failure before raising, so there is nothing left to retry;
    report_line() carries the name onward to stderr (the same "nothing left to report; the exit
    code is the only channel" reasoning report_line's own docstring states), and the run record
    write below is deliberately still attempted -- a doomed STDOUT says nothing about whether the
    JSON file can be written.
    """
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    at = now_utc()
    counts = tally(state["outcomes"])
    record_path = outcome_path(options.file, at)
    try:
        for line in summary_lines(
                direction=state["direction"], source=options.file,
                source_generated_at=state["generated_at"], for_real=state["for_real"],
                entries_in_file=state["entries_in_file"], selected=state["selected"],
                counts=counts, record_path=record_path):
            write_report(line)
    except StartupError as e:
        report_line(f"ERROR: {e}")
    try:
        write_run_record(record_path, outcome_document(
            at=at, direction=state["direction"], source=options.file,
            source_generated_at=state["generated_at"], for_real=state["for_real"],
            argv=argv, exit_code=code, entries_in_file=state["entries_in_file"],
            selected=state["selected"], counts=counts, outcomes=state["outcomes"],
            details=state["details"], validations=state["validations"]))
    except OutputWriteError as e:
        # SPEC 9.2's precedence rule.  A run that CHANGED something (changed_count > 0) keeps its
        # EARNED code: exiting 2 here would assert "nothing was changed" about production DNS this
        # very run just rewrote -- the worse of the two lies PD#1 has to choose between.  A run
        # that changed NOTHING (a dry run, or an already-applied-only run) had the record as its
        # ONLY deliverable, so failing to write it IS the failure -- 2.
        report_line(f"ERROR: {e}")
        return code if changed_count(counts) else 2
    return code


def run_once(options, state):
    """The core three-pass flow (SPEC section 4): require_usable_streams() through the final
    finish() call.  Module-level for the same C901/PLR0915 reason finish() is (see its
    docstring) -- this is the SAME sequence Tasks 1-8 built, unchanged except for reading/writing
    `state` instead of main()'s own locals.  main()'s try calls this once and routes whatever it
    raises to the right `except` clause.

    `state["outcomes"]` is seeded `not-attempted` for every SELECTED entry the moment selection
    succeeds -- not built at the end from whatever the happy path finished with -- so a validation
    failure or an interrupt still produces a COMPLETE per-entry run record (task 9 requirement 1).
    """
    require_usable_streams()

    doc = read_apply_file(options.file)
    direction = check_file_contract(doc, options.file)
    state["direction"] = direction
    state["generated_at"] = doc["generated"].get("at", "unknown")
    state["entries_in_file"] = len(doc["entries"])

    entries = select_entries(doc["entries"], options.only)
    state["selected"] = len(entries)
    state["outcomes"] = dict.fromkeys(entries, "not-attempted")   # see the docstring above
    if len(entries) != len(doc["entries"]):
        print(f"ATTENTION: applying {len(entries)} of {len(doc['entries'])} entries in "
              f"this file", file=sys.stderr, flush=True)
    client = cloudflare_client(options.config)
    validations = validate_entries(client, entries, verbose=options.verbose)
    state["validations"] = validations

    if abort_on_invalid_entries(validations):
        return "abort"   # main() maps this to finish(2); see its own docstring

    report_entries(entries, validations, verbose=options.verbose)
    if options.for_real:
        report_line("FOR REAL -- changes WILL be made to Cloudflare")  # SPEC 11.2: printed
        # before the first batch call.
        # Caller-owned (Task 8 review, minor 11): apply_all mutates state["outcomes"]/
        # state["details"] IN PLACE, so a KeyboardInterrupt raised out of it still leaves `state`
        # holding the in-flight entry's `unknown` outcome and every entry reached before it --
        # main()'s `except KeyboardInterrupt` clause reads the SAME dicts, not a copy that
        # unwound with the exception.
        apply_all(client, entries, validations, state["outcomes"], state["details"])
    else:
        state["outcomes"] = {fqdn: ("already-applied" if v.verdict == "already-applied"
                                    else "planned")
                             for fqdn, v in validations.items()}
    return exit_code_for(tally(state["outcomes"]))


def main(argv):
    """Exit 0/1/2/3/130 -- see the module docstring and SPEC section 8.

    THE EXIT-CODE DISCIPLINE IS THE POINT OF THE STRUCTURE BELOW, ported in reasoning from
    find-platform-domains-cloudflare's main().  CPython exits 1 on ANY uncaught traceback, and 1
    here means "completed with already-applied skips" -- so an unexpected API shape or an internal
    defect leaking out of here would be indistinguishable to an operator's `case $?` from a
    healthy run.  Every other outcome is routed AWAY from 1.  The `except BaseException` arm is
    the last line of defence; `except SystemExit: raise` sits above it so a deliberate exit keeps
    its own code.  Neither swallows: the class is always named on stderr (PD#2).

    `state` is the run's accumulator (SPEC R8.1/R9.1), passed to `run_once()` and `finish()`
    (module-level siblings, not nested closures -- see their own docstrings for why) so both read
    and write the SAME dict this function holds.  `finish()` is the ONE place that prints the
    summary block and writes the run record -- called from every exit below: the happy/abort path
    (via `run_once()`'s "abort" sentinel) and every `except` clause except `SystemExit`, which
    re-raises past it entirely by design (SPEC 8.3).
    """
    options = build_arg_parser().parse_args(argv)
    state = {"direction": "unknown", "generated_at": "unknown", "entries_in_file": 0,
             "selected": 0, "outcomes": {}, "details": {}, "validations": {},
             "for_real": options.for_real}
    try:
        result = run_once(options, state)
        code = 2 if result == "abort" else result
        return finish(code, options=options, argv=argv, state=state)
    except StartupError as e:
        report_line(f"ERROR: {e}")
        # Task 9 review-deferred defect: an InvariantError (a StartupError subclass) escaping
        # apply_all mid-run -- an entry reaching pass 3 with a verdict pass 1 should have caught,
        # or a delete-id/body shape section 6 should already have rejected -- must not report exit
        # 2 ("nothing was changed") when an EARLIER entry in the SAME run already applied.  SPEC
        # 9.1's table currently pins InvariantError's own row flatly to 2; this is a stated,
        # deliberate deviation from that row's literal text for exactly the changed>0 case, using
        # the SAME changed_count() rule ApplyError/VerifyError already earn 2-vs-3 through via
        # exit_code_for (SPEC 8.1) -- see the task report for the SPEC amendment this implies.
        changed = changed_count(tally(state["outcomes"]))
        return finish(3 if changed else 2, options=options, argv=argv, state=state)
    except KeyboardInterrupt:
        report_line("ERROR: interrupted")
        return finish(130, options=options, argv=argv, state=state)
    except OSError as e:
        report_line(f"ERROR: {e}")
        return finish(2, options=options, argv=argv, state=state)
    except SystemExit:
        raise
    except BaseException as e:  # noqa: BLE001 -- deliberate last line of defence, see the
        # docstring: without it CPython's exit 1 on an uncaught traceback would be
        # indistinguishable from this program's own exit 1.
        report_line(f"ERROR: unexpected {type(e).__name__}: {e}")
        return finish(2, options=options, argv=argv, state=state)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
