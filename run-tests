#!/usr/bin/env python3
"""Thin wrapper over pytest for the pantheon-sitehealth-emails harness.

Two audiences, one entry point (SPEC §5.8):
  ./run-tests                 human-readable, all tiers (incl. live)
  ./run-tests --fast          offline subset only  (-m "not live and not slow")
  ./run-tests --llm           terse, machine-parseable summary (for Claude Code)
  ./run-tests --coverage      pytest-cov (reported, no gate; in-process tiers)
  ./run-tests --update-goldens  refresh syrupy snapshots
  ./run-tests --record        re-record the terminus fixtures from the live test site

Any other arguments (-k EXPR, -m MARK, paths, ...) are passed straight through to pytest.
"""
import importlib.util
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent
PYPROJECT = ROOT / "pyproject.toml"


def ruff_argv():
    """How to invoke ruff here, or None if it cannot be invoked at all.

    `ruff` is not necessarily on PATH (this repo installs deps with uv), so fall back to
    `uvx ruff@0.15.22` -- PINNED, not `uvx ruff`.  Mirrors .claude/hooks/ruff-check.sh -- the
    two must agree on the binary AND version just as they agree on the rule set (both read
    the single merged config in pyproject.toml; neither passes --select).

    WHY PINNED (CAMPAIGN.md section 13, decision D2): the campaign's lint bar is fixed at
    increment I0 and never shifts mid-campaign.  ruff 0.16.0 graduated the preview rule
    PLR0917 to stable, and the merged select=ALL gate (pyproject.toml [tool.ruff.lint])
    newly fails against it -- 9 findings in six files that were clean under 0.15.22.  An unpinned `uvx ruff`
    would silently move the bar on the next `uvx` cache refresh, turning a clean tree red
    with no code change (PD#14: an instrument -- the lint gate -- that changes verdict for
    reasons outside the diff is exactly the kind of lying instrument that directive names).
    Upgrading ruff is a deliberate post-campaign / ratchet-flip decision, made on purpose and
    reviewed like any other ratchet change -- not something a cache refresh may do silently.
    If `ruff` is on PATH instead (the `shutil.which("ruff")` branch below), it is trusted
    as-is with NO version check -- a residual, accepted exposure.  Keep that branch (it's how
    a real dev install runs faster than `uvx`), but whoever installs it must match the pin
    above (0.15.22) or this gate can silently drift from the uvx fallback's guarantee.

    WHY THIS IS NOT SHAPED LIKE pyright_argv() (a deliberate asymmetry, not an oversight):
    ruff's verdict depends only on the source it reads and the config in pyproject.toml, so
    ANY ruff of the pinned version gives the same answer wherever it came from -- PATH, uvx,
    or a venv.  pyright's verdict additionally depends on the Python environment it resolves
    imports against, which is why that gate refuses every binary but this venv's and pins its
    version by measurement instead of by convention (pyright_version_problem below).
    """
    if shutil.which("ruff"):
        return ["ruff"]
    if shutil.which("uvx"):
        return ["uvx", "ruff@0.15.22"]
    return None


def pyright_argv():
    """How to invoke pyright here, or None if it is not installed in THIS environment.

    Deliberately NOT ruff_argv()'s pattern: no `shutil.which("pyright")`, no `uvx` fallback.
    Unlike ruff, pyright's verdict depends on the Python environment it resolves imports
    against, so ANY pyright that is not this repo's venv one type-checks psh/ with none of
    the project's dependencies installed.  The dropped `uvx pyright@1.1.411` fallback did
    exactly that -- 34 false `reportMissingImports` (CLOSING-AUDIT.md; the README TODO this
    closes) -- and a PATH pyright from elsewhere (an npm-global install, say) does the same
    whenever the venv is not active, which is worse: it looks like the intended branch.

    So BOTH halves are anchored on `sys.executable` -- the interpreter running ./run-tests,
    i.e. the venv's, exactly as main()'s `python -m pytest` invocation does:

      * `-m pyright` picks the pyright INSTALLED IN that interpreter, making
        `pyright==1.1.411` in pyproject's [test] extra the ONE thing deciding the version
        (CAMPAIGN.md section 13 / decision D2: the type bar cannot drift for reasons outside
        the diff, PD#14).  Residual exposure: a stale venv, predating a change to that pin.
      * `--pythonpath` names the interpreter pyright RESOLVES IMPORTS AGAINST, and it is
        load-bearing, not belt-and-braces.  Measured: pyright otherwise finds the environment
        via the `python` on PATH, so `.venv/bin/python run-tests` with the venv merely not
        ACTIVATED (no `source .venv/bin/activate`) reports 46 false `reportMissingImports` --
        the dropped fallback's failure mode, reached through the right binary.
    """
    if importlib.util.find_spec("pyright") is None:
        return None
    return [sys.executable, "-m", "pyright", "--pythonpath", sys.executable]


def pinned_pyright_version(pyproject=PYPROJECT):
    """The `pyright==<version>` pin from pyproject's [test] extra, or None if there isn't one.

    DERIVED, never duplicated: the pin has exactly one home (the [test] extra, which is what
    `uv pip install .[test]` actually installs), so this gate cannot drift from it the way a
    second copy of the number here would.
    """
    data = tomllib.loads(Path(pyproject).read_text(encoding="utf-8"))
    for requirement in data["project"]["optional-dependencies"]["test"]:
        name, sep, version = requirement.partition("==")
        if sep and name.strip() == "pyright":
            return version.strip()
    return None


def pyright_version_problem(argv):
    """None if the pyright `argv` invokes is the pinned one, else a printable explanation.

    This closes the one drift route left after the venv binary became mandatory: a STALE VENV
    -- installed before the pin moved, or hand-installed with `pip install pyright` -- type
    checks psh/ at a different pyright and says nothing, which is the ruff-drift class (PD#14)
    reached through the environment instead of through a `uvx` cache.

    The version is read from the tool ITSELF (`--version`, measured at 0.3s) rather than from
    `importlib.metadata.version("pyright")`, which reports the pyright-python WRAPPER's
    version: `PYRIGHT_PYTHON_FORCE_VERSION` moves the real checker underneath it, and an
    instrument reporting a version other than the one it ran is exactly what PD#14 names.

    EVERY failure to establish the version is a problem, never a pass (PD#1: a check that
    cannot run must not quietly stop checking) -- including a missing pin, which would
    otherwise turn a typo in pyproject.toml into a silently unverified gate.
    """
    pinned = pinned_pyright_version()
    if pinned is None:
        return (
            "pyproject.toml's [test] extra carries no `pyright==<version>` pin, so the type "
            "gate's version cannot be verified."
        )
    try:
        completed = subprocess.run(
            [*argv, "--version"], cwd=str(ROOT), capture_output=True, text=True, check=False
        )
    except OSError as e:
        return f"`pyright --version` could not be run ({e}), so the type gate's version cannot be verified."
    reported = completed.stdout.split()
    if completed.returncode != 0 or len(reported) < 2 or reported[0] != "pyright":
        return (
            f"`pyright --version` reported no version (exit {completed.returncode}, stdout "
            f"{completed.stdout.strip()!r}), so the type gate's version cannot be verified."
        )
    if reported[1] != pinned:
        return (
            f"pyright {reported[1]} is installed in {sys.executable}, but pyproject.toml's "
            f"[test] extra pins pyright=={pinned}."
        )
    return None


def run_gates():
    """The lint + type gates.  Returns an exit code; 0 means every gate is clean.

    Two gates run in order, each aborting the step on the first nonzero result -- so a later
    gate's green never hides an earlier gate's red:
      1. ruff, select = ALL minus the justified ignores in pyproject.toml [tool.ruff.lint] --
         ONE pass (the campaign's two configs merged at I14b).  Includes the four PD rules
         (E722/BLE001/S105/S106) that each mechanize a directive in prompts/directives.md and
         run everywhere not excluded, plus the broad best-practice ratchet (CAMPAIGN.md 13).
      2. pyright, standard mode over psh/ (pyproject [tool.pyright]) -- this venv's pyright,
         with its version VERIFIED against the [test] extra's pin before it runs.

    Each gate prints a one-line label first, so a failure names its own gate (PD#1:
    failures surfaced actionably to the operator).  No --select on the ruff pass: the merged
    config is the single source of truth, matching .claude/hooks/ruff-check.sh.  Output is
    `concise`, so a ruff finding names the file, line, and rule.
    """
    argv = ruff_argv()
    if argv is None:
        # PD#1, zero silent failures: a gate that cannot run must not quietly stop gating.
        # Skipping here would let E722/BLE001/S105 land while the suite still reported green
        # -- an instrument that lies (PD#14).  Fail loudly and actionably instead.
        print(
            "ERROR: neither `ruff` nor `uvx` is on PATH, so the lint gate cannot run.\n"
            "       The suite is NOT green without it -- it is unverified.\n"
            "       Install uv (see README.md) or `pip install ruff`.",
            file=sys.stderr,
        )
        return 1

    print("Linting (ruff, campaign ratchet) ...")
    completed = subprocess.call(
        [*argv, "check", "--output-format", "concise", "."], cwd=str(ROOT)
    )
    if completed != 0:
        print(
            "\nLint gate FAILED -- fix the findings above, or add a noqa WITH AN INLINE\n"
            "REASON if the code is deliberate (a bare noqa is a silent failure).\n"
            "This is the merged campaign ratchet (select = ALL, CAMPAIGN.md section 13); it\n"
            "carries the PD#2/PD#6 rules (E722/BLE001/S105/S106) plus the broad best-practice set.",
            file=sys.stderr,
        )
        return completed

    print("Type-checking (pyright, campaign ratchet) ...")
    pargv = pyright_argv()
    if pargv is None:
        # PD#1 again: pyright missing must FAIL, never silently skip -- a gate that does not
        # run is the shim failure mode CLAUDE.md warns about (a green that was never earned).
        print(
            f"ERROR: pyright is not installed in {sys.executable}, so the type gate cannot run.\n"
            "       The suite is NOT green without it -- it is unverified.\n"
            "       Activate the venv (`source .venv/bin/activate`) and install the pinned\n"
            "       pyright with `uv pip install .[test]`.  A pyright from anywhere else is\n"
            "       deliberately not used: it cannot see the project's dependencies.",
            file=sys.stderr,
        )
        return 1

    problem = pyright_version_problem(pargv)
    if problem is not None:
        # The pin is the gate's bar (CAMPAIGN.md section 13 / D2).  Running an unverified
        # pyright would report a verdict for a bar nobody chose -- fail instead (PD#14).
        print(
            f"ERROR: {problem}\n"
            "       The suite is NOT green without a verified type gate -- it is unverified.\n"
            "       Re-sync this environment with `uv pip install .[test]`.",
            file=sys.stderr,
        )
        return 1

    completed = subprocess.call([*pargv], cwd=str(ROOT))
    if completed != 0:
        print(
            "\nType gate FAILED (pyright, campaign ratchet) -- fix the type findings above.\n"
            "Scope is psh/; it ratchets up as increments move typed code in.",
            file=sys.stderr,
        )
    return completed


def main(argv):
    wrapper_flags = {
        "--fast", "--llm", "--human", "--coverage", "--update-goldens", "--record",
    }
    ours = [a for a in argv if a in wrapper_flags]
    passthrough = [a for a in argv if a not in wrapper_flags]

    if "--record" in ours:
        return subprocess.call([sys.executable, str(ROOT / "tests" / "tools" / "record.py")])

    # Lint AND type-check BEFORE pytest, and gate on them -- in --fast and full alike.  They
    # run in a few seconds, and a red gate here means the tree violates a directive or the
    # campaign ratchet, which no amount of green tests makes acceptable.  --record is exempt:
    # it re-records fixtures from live Pantheon and never reaches this line.
    rc = run_gates()
    if rc != 0:
        return rc

    pytest_args = ["-p", "no:cacheprovider"]

    if "--fast" in ours:
        pytest_args += ["-m", "not live and not slow"]
    if "--llm" in ours:
        # Terse and machine-parseable: quiet, short tracebacks, no color/header, plus the
        # conftest --llm summary hook (LLM_SUMMARY / FAILED <nodeid> lines).
        pytest_args += ["--llm", "-q", "--tb=short", "--color=no", "--no-header"]
    if "--coverage" in ours:
        pytest_args += ["--cov", "--cov-report=term-missing"]
    if "--update-goldens" in ours:
        pytest_args += ["--snapshot-update"]

    pytest_args += passthrough
    return subprocess.call([sys.executable, "-m", "pytest", *pytest_args], cwd=str(ROOT))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
